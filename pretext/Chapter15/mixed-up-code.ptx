<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter12_mixed-up-code">
    <title>Chapter 12 Mixed-Up Code Practice</title>

    <exercise label="chapter12_muc_read-lines" number="yes" adaptive="yes" indentation="show">
        <statement><p>Arrange the blocks to open a text file and process each line.</p></statement>
        <blocks>
            <block order="1"><cline>std::ifstream input_file{"notes.txt"};</cline></block>
            <block order="2"><cline>if (!input_file) { return 1; }</cline></block>
            <block order="3"><cline>std::string line;</cline></block>
            <block order="4"><cline>while (std::getline(input_file, line)) {</cline></block>
            <block order="5"><cline>    std::cout &lt;&lt; line &lt;&lt; '\n';</cline></block>
            <block order="6"><cline>}</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter12_muc_csv-parser" number="yes" adaptive="yes" indentation="show">
        <statement><p>Arrange the blocks to parse and validate a simple score record.</p></statement>
        <blocks>
            <block order="1"><cline>std::istringstream record_stream{line};</cline></block>
            <block order="2"><cline>std::getline(record_stream, name, ',');</cline></block>
            <block order="3"><cline>record_stream &gt;&gt; score;</cline></block>
            <block order="4"><cline>record_stream &gt;&gt; std::ws;</cline></block>
            <block order="5"><cline>return !name.empty() &amp;&amp; record_stream.eof();</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter12_muc_binary-read" number="yes" adaptive="yes" indentation="show">
        <statement><p>Arrange the blocks to read complete binary integers.</p></statement>
        <blocks>
            <block order="1"><cline>std::int32_t value{};</cline></block>
            <block order="2"><cline>while (input_file.read(</cline></block>
            <block order="3"><cline>    reinterpret_cast&lt;char*&gt;(&amp;value),</cline></block>
            <block order="4"><cline>    sizeof value</cline></block>
            <block order="5"><cline>)) {</cline></block>
            <block order="6"><cline>    std::cout &lt;&lt; value &lt;&lt; '\n';</cline></block>
            <block order="7"><cline>}</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter12_muc-random-access" number="yes" adaptive="yes" indentation="show">
        <statement><p>Arrange the blocks to locate and read a fixed-size record.</p></statement>
        <blocks>
            <block order="1"><cline>std::streamoff offset{record_number * record_size};</cline></block>
            <block order="2"><cline>input_file.seekg(offset, std::ios::beg);</cline></block>
            <block order="3"><cline>input_file.read(reinterpret_cast&lt;char*&gt;(&amp;record), sizeof record);</cline></block>
            <block order="4"><cline>std::cout &lt;&lt; record.score &lt;&lt; '\n';</cline></block>
        </blocks>
    </exercise>
</exercises>
