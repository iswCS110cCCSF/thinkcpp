<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter12_component-exercises">
    <title>Chapter 12 Exercises</title>

    <exercise label="chapter12_component_text-binary">
        <statement><p>Which statement best distinguishes text and binary files?</p></statement>
        <choices randomize="yes">
            <choice><statement><p>Text files cannot store numbers.</p></statement><feedback><p>Text files can store numbers as characters.</p></feedback></choice>
            <choice correct="yes"><statement><p>Text files use a character-oriented format, while binary files use a documented byte-oriented format.</p></statement><feedback><p>The distinction concerns representation, not whether the data are useful.</p></feedback></choice>
            <choice><statement><p>Binary files never need documentation.</p></statement><feedback><p>Binary readers need format rules.</p></feedback></choice>
            <choice><statement><p>Only binary files can be persistent.</p></statement><feedback><p>Both formats can be persistent.</p></feedback></choice>
            <choice><statement><p>Text files are always portable.</p></statement><feedback><p>Text encoding and format rules still matter.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter12_component_csv">
        <statement><p>What should a simple CSV parser do after extracting the expected fields?</p></statement>
        <choices randomize="yes">
            <choice><statement><p>Assume the line is valid without further checks.</p></statement><feedback><p>Input still needs validation.</p></feedback></choice>
            <choice correct="yes"><statement><p>Check ranges, extra content, and other documented rules.</p></statement><feedback><p>Parsing and validation are related but distinct tasks.</p></feedback></choice>
            <choice><statement><p>Convert the record into a binary file automatically.</p></statement><feedback><p>File conversion is a separate operation.</p></feedback></choice>
            <choice><statement><p>Ask for keyboard input inside the parser.</p></statement><feedback><p>The parser should process the line it receives.</p></feedback></choice>
            <choice><statement><p>Delete malformed input silently.</p></statement><feedback><p>The application should choose an explicit reporting or recovery policy.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter12_component_endian">
        <statement><p>Select all requirements for a portable binary format.</p></statement>
        <choices randomize="yes" multiple-correct="yes">
            <choice correct="yes"><statement><p>Specify field widths and meanings.</p></statement><feedback><p>The reader must know how to interpret each field.</p></feedback></choice>
            <choice correct="yes"><statement><p>Specify byte order for multi-byte values.</p></statement><feedback><p>Native byte order is not automatically portable.</p></feedback></choice>
            <choice correct="yes"><statement><p>Provide a version or format identifier.</p></statement><feedback><p>Versioning helps readers detect format changes.</p></feedback></choice>
            <choice><statement><p>Persist raw pointer addresses.</p></statement><feedback><p>Addresses are not stable serialized references.</p></feedback></choice>
            <choice><statement><p>Let readers guess unknown fields.</p></statement><feedback><p>Explicit rules are safer than guessing.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter12_component_exceptions">
        <statement><p>Why should ordinary end-of-file usually be handled differently from a serious I/O failure?</p></statement>
        <choices randomize="yes">
            <choice correct="yes"><statement><p>End-of-file is often an expected stopping condition, while a serious I/O failure requires reporting or recovery.</p></statement><feedback><p>The program should distinguish expected control flow from failure.</p></feedback></choice>
            <choice><statement><p>End-of-file always means the file was corrupted.</p></statement><feedback><p>End-of-file is normal for many read loops.</p></feedback></choice>
            <choice><statement><p>Serious I/O failures never affect stream state.</p></statement><feedback><p>They are represented by stream-state flags.</p></feedback></choice>
            <choice><statement><p>Exceptions remove the need to check files.</p></statement><feedback><p>Exceptions are one error-handling strategy, not a substitute for design.</p></feedback></choice>
            <choice><statement><p>Binary files cannot reach end-of-file.</p></statement><feedback><p>All finite files have an end.</p></feedback></choice>
        </choices>
    </exercise>
</exercises>
