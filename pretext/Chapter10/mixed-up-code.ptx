<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter8_mixed-up-code">
    <title>Mixed-Up Code Practice</title>

    <exercise label="chapter8_mixed_up_create_vector" number="yes" adaptive="yes" indentation="hide">
        <statement>
            <p>Arrange the blocks to create a vector of three scores and print its size.</p>
        </statement>
        <blocks>
            <block order="1"><cline>#include &lt;iostream&gt;</cline><cline>#include &lt;vector&gt;</cline></block>
            <block order="2"><cline>int main() {</cline></block>
            <block order="3"><cline>    std::vector&lt;int&gt; scores{82, 91, 88};</cline></block>
            <block order="4"><cline>    std::cout &lt;&lt; scores.size() &lt;&lt; '\n';</cline></block>
            <block order="5"><cline>    return 0;</cline><cline>}</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter8_mixed_up_range_traversal" number="yes" adaptive="yes" indentation="hide">
        <statement>
            <p>Arrange the blocks to print every value in the vector.</p>
        </statement>
        <blocks>
            <block order="1"><cline>std::vector&lt;int&gt; values{3, 6, 9};</cline></block>
            <block order="2"><cline>for (const int value : values) {</cline></block>
            <block order="3"><cline>    std::cout &lt;&lt; value &lt;&lt; ' ';</cline><cline>}</cline></block>
            <block order="4"><cline>std::cout &lt;&lt; '\n';</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter8_mixed_up_add_values" number="yes" adaptive="yes" indentation="hide">
        <statement>
            <p>Arrange the blocks to add the values in a vector.</p>
        </statement>
        <blocks>
            <block order="1"><cline>int calculate_total(const std::vector&lt;int&gt;&amp; values) {</cline></block>
            <block order="2"><cline>    int total = 0;</cline></block>
            <block order="3"><cline>    for (const int value : values) {</cline></block>
            <block order="4"><cline>        total += value;</cline><cline>    }</cline></block>
            <block order="5"><cline>    return total;</cline><cline>}</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter8_mixed_up_vector_operation" number="yes" adaptive="yes" indentation="hide">
        <statement>
            <p>Arrange the blocks to add a value and remove the last value.</p>
        </statement>
        <blocks>
            <block order="1"><cline>std::vector&lt;int&gt; values{10, 20};</cline></block>
            <block order="2"><cline>values.push_back(30);</cline></block>
            <block order="3"><cline>values.pop_back();</cline></block>
            <block order="4"><cline>std::cout &lt;&lt; values.size() &lt;&lt; '\n';</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter8_mixed_up_object_vector" number="yes" adaptive="yes" indentation="hide">
        <statement>
            <p>Arrange the blocks to define a class that stores a vector of integers privately.</p>
        </statement>
        <blocks>
            <block order="1"><cline>class Score_book {</cline></block>
            <block order="2"><cline>private:</cline><cline>    std::vector&lt;int&gt; scores;</cline></block>
            <block order="3"><cline>public:</cline><cline>    void add_score(int score) {</cline><cline>        scores.push_back(score);</cline><cline>    }</cline></block>
            <block order="4"><cline>};</cline></block>
        </blocks>
    </exercise>
</exercises>
