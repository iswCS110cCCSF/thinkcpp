<exercises xml:id="chapter5_coding-practice">
  <title>Coding Practice</title>

  <exercise label="cp_5_1">
    <statement>
      <p>
        Define a <c>Point</c> structure with public data members <c>x</c> and
        <c>y</c>. Then write <c>move_point</c>, which receives a
        <c>Point&amp;</c> and adds the given amounts to its coordinates.
      </p>
      <program interactive="activecode" label="cp_5_AC_1q">
        <code><![CDATA[
#include <iostream>

struct Point {
    // Add the data members here.
};

void move_point(Point& point, double change_x, double change_y) {
    // Add the statements that change the point here.
}

int main() {
    Point point{2.0, 3.0};

    move_point(point, 4.0, -1.0);

    std::cout << point.x << ", " << point.y << '\n';

    return 0;
}
        ]]></code>
      </program>
    </statement>
    <solution>
      <p>One possible solution is:</p>
      <program xml:id="cp_5_AC_1a">
        <code><![CDATA[
#include <iostream>

struct Point {
    double x;
    double y;
};

void move_point(Point& point, double change_x, double change_y) {
    point.x += change_x;
    point.y += change_y;
}

int main() {
    Point point{2.0, 3.0};

    move_point(point, 4.0, -1.0);

    std::cout << point.x << ", " << point.y << '\n';

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>

  <exercise label="cp_5_2">
    <statement>
      <p>
        Define a <c>Rectangle</c> class with private <c>width</c> and
        <c>height</c> data members. Add a public member function named
        <c>calculate_area</c> that returns the area.
      </p>
      <program interactive="activecode" label="cp_5_AC_2q">
        <code><![CDATA[
#include <iostream>

class Rectangle {
    // Add the appropriate access specifiers and members here.
};

int main() {
    Rectangle rectangle;

    // Add code that assigns dimensions if your design requires it.
    // Then print the rectangle's area.

    return 0;
}
        ]]></code>
      </program>
    </statement>
    <solution>
      <p>One possible solution uses a constructor to initialize the dimensions:</p>
      <program xml:id="cp_5_AC_2a">
        <code><![CDATA[
#include <iostream>

class Rectangle {
private:
    double width;
    double height;

public:
    Rectangle(double rectangle_width, double rectangle_height)
        : width{rectangle_width}, height{rectangle_height} {
    }

    double calculate_area() const {
        return width * height;
    }
};

int main() {
    Rectangle rectangle{4.0, 3.0};

    std::cout << rectangle.calculate_area() << '\n';

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>

  <exercise label="cp_5_3">
    <statement>
      <p>
        Create a <c>Counter</c> class. Its private <c>count</c> data member
        should begin at zero. Add a constructor that accepts a starting count,
        an <c>increase_count</c> member function, and a const accessor named
        <c>get_count</c>.
      </p>
      <program interactive="activecode" label="cp_5_AC_3q">
        <code><![CDATA[
#include <iostream>

class Counter {
    // Define the class.
};

int main() {
    Counter counter{10};

    counter.increase_count();
    counter.increase_count();

    std::cout << counter.get_count() << '\n';

    return 0;
}
        ]]></code>
      </program>
    </statement>
    <solution>
      <program xml:id="cp_5_AC_3a">
        <code><![CDATA[
#include <iostream>

class Counter {
private:
    int count = 0;

public:
    Counter(int starting_count)
        : count{starting_count} {
    }

    void increase_count() {
        ++count;
    }

    int get_count() const {
        return count;
    }
};

int main() {
    Counter counter{10};

    counter.increase_count();
    counter.increase_count();

    std::cout << counter.get_count() << '\n';

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>

  <exercise label="cp_5_4">
    <statement>
      <p>
        Define a <c>Book</c> class with a default member initializer that
        gives <c>title</c> the value <q>Untitled</q> and <c>page_count</c> the
        value <c>0</c>. Add an overloaded constructor that accepts both
        values, along with const accessor functions.
      </p>
      <program interactive="activecode" label="cp_5_AC_4q">
        <code><![CDATA[
#include <iostream>
#include <string>

class Book {
    // Define the private data members and public functions.
};

int main() {
    Book first_book;
    Book second_book{"C++ Fundamentals", 420};

    std::cout << first_book.get_title() << " ("
              << first_book.get_page_count() << ")\n";
    std::cout << second_book.get_title() << " ("
              << second_book.get_page_count() << ")\n";

    return 0;
}
        ]]></code>
      </program>
    </statement>
    <solution>
      <program xml:id="cp_5_AC_4a">
        <code><![CDATA[
#include <iostream>
#include <string>

class Book {
private:
    std::string title = "Untitled";
    int page_count = 0;

public:
    Book() = default;

    Book(const std::string& initial_title, int initial_page_count)
        : title{initial_title}, page_count{initial_page_count} {
    }

    std::string get_title() const {
        return title;
    }

    int get_page_count() const {
        return page_count;
    }
};

int main() {
    Book first_book;
    Book second_book{"C++ Fundamentals", 420};

    std::cout << first_book.get_title() << " ("
              << first_book.get_page_count() << ")\n";
    std::cout << second_book.get_title() << " ("
              << second_book.get_page_count() << ")\n";

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>

  <exercise label="cp_5_5">
    <statement>
      <p>
        Implement a <c>BankAccount</c> class that keeps its balance private.
        Write <c>deposit_money</c> so that it accepts only positive deposits,
        and write a const accessor named <c>get_balance</c>.
      </p>
      <program interactive="activecode" label="cp_5_AC_5q">
        <code><![CDATA[
#include <iostream>

class BankAccount {
    // Define the class so outside code cannot change balance directly.
};

int main() {
    BankAccount account;

    account.deposit_money(100.00);
    account.deposit_money(-25.00);

    std::cout << account.get_balance() << '\n';

    return 0;
}
        ]]></code>
      </program>
    </statement>
    <solution>
      <program xml:id="cp_5_AC_5a">
        <code><![CDATA[
#include <iostream>

class BankAccount {
private:
    double balance = 0.0;

public:
    void deposit_money(double amount) {
        if (amount > 0) {
            balance += amount;
        }
    }

    double get_balance() const {
        return balance;
    }
};

int main() {
    BankAccount account;

    account.deposit_money(100.00);
    account.deposit_money(-25.00);

    std::cout << account.get_balance() << '\n';

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>

  <exercise label="cp_5_6">
    <statement>
      <p>
        Define a <c>Temperature</c> class with a private Celsius value. Add a
        constructor, a const accessor named <c>get_celsius</c>, and a mutator
        named <c>set_celsius</c> that accepts values from <c>-273.15</c>
        upward. Ignore an attempted assignment below absolute zero.
      </p>
      <program interactive="activecode" label="cp_5_AC_6q">
        <code><![CDATA[
#include <iostream>

class Temperature {
    // Define the class.
};

int main() {
    Temperature temperature{20.0};

    temperature.set_celsius(25.5);
    temperature.set_celsius(-300.0);

    std::cout << temperature.get_celsius() << '\n';

    return 0;
}
        ]]></code>
      </program>
    </statement>
    <solution>
      <program xml:id="cp_5_AC_6a">
        <code><![CDATA[
#include <iostream>

class Temperature {
private:
    double celsius;

public:
    Temperature(double starting_celsius)
        : celsius{starting_celsius} {
    }

    double get_celsius() const {
        return celsius;
    }

    void set_celsius(double new_celsius) {
        if (new_celsius >= -273.15) {
            celsius = new_celsius;
        }
    }
};

int main() {
    Temperature temperature{20.0};

    temperature.set_celsius(25.5);
    temperature.set_celsius(-300.0);

    std::cout << temperature.get_celsius() << '\n';

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>
</exercises>
