<?xml version="1.0" encoding="utf-8"?>
<exercises xml:id="chapter5_multiple-choice-exercises">
  <title>Multiple Choice Exercises</title>

  <exercise label="mce_5_1">
    <statement>
      <p>What does the declaration below create?</p>
      <program>
        <code><![CDATA[
struct Point {
    double x;
    double y;
};
        ]]></code>
      </program>
    </statement>
    <choices>
      <choice>
        <statement><p>One <c>Point</c> object named <c>x</c></p></statement>
        <feedback><p>The declaration defines a type; it does not create an object named <c>x</c>.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p>A user-defined type named <c>Point</c> with two data members</p></statement>
        <feedback><p>Correct. The definition describes the members that each <c>Point</c> object will contain.</p></feedback>
      </choice>
      <choice>
        <statement><p>Two variables named <c>x</c> and <c>y</c> in <c>main</c></p></statement>
        <feedback><p>The members belong to future <c>Point</c> objects; they are not local variables in <c>main</c>.</p></feedback>
      </choice>
      <choice>
        <statement><p>A function that returns a <c>Point</c></p></statement>
        <feedback><p>This code defines a structure, not a function.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_2">
    <statement>
      <p>Which statement correctly creates a <c>Point</c> object using aggregate initialization?</p>
    </statement>
    <choices>
      <choice>
        <statement><p><c>Point{ } point;</c></p></statement>
        <feedback><p>This places the type name after the braces; use the type followed by the object name.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p><c>Point point{3.0, 4.0};</c></p></statement>
        <feedback><p>Correct. The values initialize <c>x</c> and <c>y</c> in declaration order.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>point Point{3.0, 4.0};</c></p></statement>
        <feedback><p>The type must come before the object name.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>Point = {3.0, 4.0};</c></p></statement>
        <feedback><p>An object name is needed; a type name cannot be assigned this way.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_3">
    <statement>
      <p>What is printed by this program?</p>
      <program>
        <code><![CDATA[
#include <iostream>

struct Rectangle {
    double length;
    double width;
};

double calculate_area(const Rectangle& rectangle) {
    return rectangle.length * rectangle.width;
}

int main() {
    Rectangle rectangle{5.0, 2.0};
    std::cout << calculate_area(rectangle) << '\n';
}
        ]]></code>
      </program>
    </statement>
    <choices>
      <choice>
        <statement><p><c>5.0</c></p></statement>
        <feedback><p>The function multiplies both members; it does not return only the length.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>2.0</c></p></statement>
        <feedback><p>The function multiplies both members; it does not return only the width.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p><c>10.0</c></p></statement>
        <feedback><p>Correct. The area is <c>5.0 * 2.0</c>.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>25.0</c></p></statement>
        <feedback><p>The expression multiplies length by width, not length by itself.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_4">
    <statement>
      <p>Which parameter form is most appropriate for a function that only reads a large object?</p>
    </statement>
    <choices>
      <choice>
        <statement><p><c>Rectangle rectangle</c></p></statement>
        <feedback><p>This passes a copy, which may be unnecessary when the function only reads the object.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>Rectangle&amp; rectangle</c></p></statement>
        <feedback><p>A non-const reference allows modification, which is not needed for a read-only function.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p><c>const Rectangle&amp; rectangle</c></p></statement>
        <feedback><p>Correct. This avoids a copy and prevents the function from modifying the argument.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>const Rectangle rectangle&amp;</c></p></statement>
        <feedback><p>The ampersand belongs before the parameter name: <c>const Rectangle&amp; rectangle</c>.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_5">
    <statement>
      <p>Which statement about a member function is true?</p>
    </statement>
    <choices>
      <choice correct="yes">
        <statement><p>It is declared as part of a structure or class and can be called on an object of that type.</p></statement>
        <feedback><p>Correct. The object appears before the dot when the function is called.</p></feedback>
      </choice>
      <choice>
        <statement><p>It must always receive the current object as an explicit parameter.</p></statement>
        <feedback><p>The current object is an implicit part of a member-function call.</p></feedback>
      </choice>
      <choice>
        <statement><p>It can only read data members and cannot modify them.</p></statement>
        <feedback><p>Non-const member functions can modify the current object's data members.</p></feedback>
      </choice>
      <choice>
        <statement><p>It cannot be defined outside the class or structure definition.</p></statement>
        <feedback><p>A member function can be defined outside using the scope resolution operator.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_6">
    <statement>
      <p>What does <c>const</c> at the end of this member-function declaration mean?</p>
      <program>
        <code><![CDATA[
double get_balance() const;
        ]]></code>
      </program>
    </statement>
    <choices>
      <choice>
        <statement><p>The return value cannot be a <c>double</c>.</p></statement>
        <feedback><p>The return type is still <c>double</c>; the trailing <c>const</c> applies to the member function.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p>The function promises not to change the object's state.</p></statement>
        <feedback><p>Correct. A const member function can observe the object but cannot normally modify its data members.</p></feedback>
      </choice>
      <choice>
        <statement><p>The function can only be called from inside the class.</p></statement>
        <feedback><p><c>const</c> does not control public or private access.</p></feedback>
      </choice>
      <choice>
        <statement><p>The object must be declared with the keyword <c>const</c>.</p></statement>
        <feedback><p>Const objects require const member functions, but a const member function can also be called on a non-const object.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_7">
    <statement>
      <p>Which statement correctly describes the default access of a <c>struct</c> and a <c>class</c>?</p>
    </statement>
    <choices>
      <choice correct="yes">
        <statement><p>Struct members are public by default; class members are private by default.</p></statement>
        <feedback><p>Correct. Either type can change its access explicitly with an access specifier.</p></feedback>
      </choice>
      <choice>
        <statement><p>Struct members are private by default; class members are public by default.</p></statement>
        <feedback><p>The defaults are reversed: structs begin public and classes begin private.</p></feedback>
      </choice>
      <choice>
        <statement><p>Structs can have data members, but classes cannot.</p></statement>
        <feedback><p>Both structs and classes can have data members.</p></feedback>
      </choice>
      <choice>
        <statement><p>Classes can have constructors, but structs cannot.</p></statement>
        <feedback><p>Both structs and classes can have constructors, including overloaded constructors.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_8">
    <statement>
      <p>What is the main purpose of making a class data member private?</p>
    </statement>
    <choices>
      <choice>
        <statement><p>To prevent the data member from ever changing</p></statement>
        <feedback><p>Private data can still be changed by appropriate member functions.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p>To control how outside code accesses and changes the object's state</p></statement>
        <feedback><p>Correct. This supports encapsulation and helps protect the object's invariants.</p></feedback>
      </choice>
      <choice>
        <statement><p>To prevent member functions of the same class from using it</p></statement>
        <feedback><p>Member functions can directly access private members of their own class.</p></feedback>
      </choice>
      <choice>
        <statement><p>To make the data member shared by every object</p></statement>
        <feedback><p>Access control does not determine whether a member is shared.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_9">
    <statement>
      <p>Which line is a valid constructor declaration for <c>Book</c>?</p>
    </statement>
    <choices>
      <choice>
        <statement><p><c>void Book();</c></p></statement>
        <feedback><p>A constructor has no return type, including <c>void</c>.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p><c>Book(std::string initial_title);</c></p></statement>
        <feedback><p>Correct. The constructor has the class name and no return type.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>book(std::string initial_title);</c></p></statement>
        <feedback><p>The constructor name must match the class name, including capitalization.</p></feedback>
      </choice>
      <choice>
        <statement><p><c>Book Book(std::string initial_title);</c></p></statement>
        <feedback><p>A constructor does not have a return type before its name.</p></feedback>
      </choice>
    </choices>
  </exercise>

  <exercise label="mce_5_10">
    <statement>
      <p>What is the purpose of the scope resolution operator in this definition?</p>
      <program>
        <code><![CDATA[
double Rectangle::calculate_area() const {
    return length * width;
}
        ]]></code>
      </program>
    </statement>
    <choices>
      <choice>
        <statement><p>It makes <c>calculate_area</c> a free function.</p></statement>
        <feedback><p>The operator identifies <c>Rectangle</c> as the class that owns the member function.</p></feedback>
      </choice>
      <choice correct="yes">
        <statement><p>It identifies <c>calculate_area</c> as a member function of <c>Rectangle</c>.</p></statement>
        <feedback><p>Correct. The <c>::</c> operator connects the function definition to its class.</p></feedback>
      </choice>
      <choice>
        <statement><p>It gives <c>length</c> and <c>width</c> public access.</p></statement>
        <feedback><p>Access is controlled by <c>public</c> and <c>private</c>, not by <c>::</c>.</p></feedback>
      </choice>
      <choice>
        <statement><p>It calls the function immediately.</p></statement>
        <feedback><p>The definition declares what the function does; a call requires an object and parentheses.</p></feedback>
      </choice>
    </choices>
  </exercise>
</exercises>
