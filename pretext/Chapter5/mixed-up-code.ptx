<?xml version="1.0" encoding="utf-8"?>
<exercises xml:id="chapter5_mixed-up-code-practice">
  <title>Mixed-Up Code Practice</title>

  <p>
    Put the code blocks in the correct order to practice defining structures,
    member functions, constructors, and simple classes.
  </p>

  <exercise label="mucp_5_1"
            number="yes"
            adaptive="yes"
            indentation="show">
    <statement>
      <p>Arrange the blocks to define a <c>Rectangle</c> structure with a member function that calculates its area.</p>
    </statement>
    <blocks>
      <block order="1"><cline>struct Rectangle {</cline></block>
      <block order="2">
        <cline>    double length;</cline>
        <cline>    double width;</cline>
      </block>
      <block order="3">
        <cline>    double calculate_area() const {</cline>
        <cline>        return length * width;</cline>
        <cline>    }</cline>
      </block>
      <block order="4"><cline>};</cline></block>
      <block order="5"><cline>int main() {</cline></block>
      <block order="6"><cline>    Rectangle rectangle{4.0, 3.0};</cline></block>
      <block order="7"><cline>    std::cout &lt;&lt; rectangle.calculate_area() &lt;&lt; '\n';</cline></block>
      <block order="8"><cline>}</cline></block>
      <block order="9" correct="no"><cline>    return length + width;</cline></block>
    </blocks>
  </exercise>

  <exercise label="mucp_5_2"
            number="yes"
            adaptive="yes"
            indentation="show">
    <statement>
      <p>Arrange the blocks to define a <c>Counter</c> member function outside the class definition.</p>
    </statement>
    <program>
      <code><![CDATA[
class Counter {
private:
    int count = 0;

public:
    void increase_count();
};
      ]]></code>
    </program>
    <blocks>
      <block order="1"><cline>void Counter::increase_count() {</cline></block>
      <block order="2"><cline>    ++count;</cline></block>
      <block order="3"><cline>}</cline></block>
      <block order="4" correct="no"><cline>void increase_count(Counter counter) {</cline></block>
      <block order="5" correct="no"><cline>    ++counter.count;</cline></block>
    </blocks>
  </exercise>

  <exercise label="mucp_5_3"
            number="yes"
            adaptive="yes"
            indentation="show">
    <statement>
      <p>Arrange the blocks to define a class with a constructor and a const accessor function.</p>
    </statement>
    <blocks>
      <block order="1"><cline>class Temperature {</cline></block>
      <block order="2"><cline>private:</cline></block>
      <block order="3"><cline>    double celsius;</cline></block>
      <block order="4"><cline>public:</cline></block>
      <block order="5">
        <cline>    Temperature(double starting_celsius)</cline>
        <cline>        : celsius{starting_celsius} {}</cline>
      </block>
      <block order="6">
        <cline>    double get_celsius() const {</cline>
        <cline>        return celsius;</cline>
        <cline>    }</cline>
      </block>
      <block order="7"><cline>};</cline></block>
      <block order="8"><cline>int main() {</cline></block>
      <block order="9"><cline>    Temperature temperature{22.5};</cline></block>
      <block order="10"><cline>    std::cout &lt;&lt; temperature.get_celsius() &lt;&lt; '\n';</cline></block>
      <block order="11"><cline>}</cline></block>
      <block order="12" correct="no"><cline>    double Temperature();</cline></block>
      <block order="13" correct="no"><cline>    private double celsius;</cline></block>
    </blocks>
  </exercise>

  <exercise label="mucp_5_4"
            number="yes"
            adaptive="yes"
            indentation="show">
    <statement>
      <p>Arrange the blocks to define the member functions for a class declared in a header file.</p>
    </statement>
    <blocks>
      <block order="1"><cline>#include "BankAccount.h"</cline></block>
      <block order="2"><cline>void BankAccount::deposit_money(double amount) {</cline></block>
      <block order="3"><cline>    if (amount &gt; 0) {</cline></block>
      <block order="4"><cline>        balance += amount;</cline></block>
      <block order="5"><cline>    }</cline></block>
      <block order="6"><cline>}</cline></block>
      <block order="7"><cline>double BankAccount::get_balance() const {</cline></block>
      <block order="8"><cline>    return balance;</cline></block>
      <block order="9"><cline>}</cline></block>
      <block order="10" correct="no"><cline>#include &lt;BankAccount.h&gt;</cline></block>
      <block order="11" correct="no"><cline>double get_balance(BankAccount account) {</cline></block>
    </blocks>
  </exercise>
</exercises>
