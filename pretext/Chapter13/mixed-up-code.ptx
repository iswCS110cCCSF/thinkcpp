<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter13_mixed_up_code">
    <title>Chapter 13 Mixed-Up Code Practice</title>

    <exercise xml:id="chapter13_mixed_up_shape2d"
              number="yes"
              adaptive="yes"
              indentation="show">
        <statement>
            <p>Arrange the blocks to declare the abstract <c>Shape2D</c> interface.</p>
        </statement>
        <blocks randomize="yes">
            <block order="1"><cline>class Shape2D {</cline></block>
            <block order="2"><cline>public:</cline></block>
            <block order="3"><cline>    virtual double calculate_area() const = 0;</cline></block>
            <block order="4"><cline>    virtual ~Shape2D() = default;</cline></block>
            <block order="5"><cline>};</cline></block>
            <block order="3" correct="no"><cline>    double calculate_area() const;</cline></block>
        </blocks>
    </exercise>

    <exercise xml:id="chapter13_mixed_up_report"
              number="yes"
              adaptive="yes"
              indentation="show">
        <statement>
            <p>Arrange the blocks to declare a class implementing two interfaces.</p>
        </statement>
        <blocks randomize="yes">
            <block order="1"><cline>class Report : public Printable, public Savable {</cline></block>
            <block order="2"><cline>public:</cline></block>
            <block order="3"><cline>    void print() const override;</cline></block>
            <block order="4"><cline>    void save() const override;</cline></block>
            <block order="5"><cline>};</cline></block>
            <block order="1" correct="no"><cline>class Report : private Printable {</cline></block>
        </blocks>
    </exercise>

    <exercise xml:id="chapter13_mixed_up_exception"
              number="yes"
              adaptive="yes"
              indentation="show">
        <statement>
            <p>Arrange the blocks to declare a custom exception derived from <c>std::invalid_argument</c>.</p>
        </statement>
        <blocks randomize="yes">
            <block order="1"><cline>class InvalidScore : public std::invalid_argument {</cline></block>
            <block order="2"><cline>public:</cline></block>
            <block order="3"><cline>    InvalidScore()</cline></block>
            <block order="4"><cline>        : std::invalid_argument{"Invalid score"} {</cline></block>
            <block order="5"><cline>    }</cline></block>
            <block order="6"><cline>};</cline></block>
            <block order="1" correct="no"><cline>class InvalidScore : private std::invalid_argument {</cline></block>
        </blocks>
    </exercise>
</exercises>
