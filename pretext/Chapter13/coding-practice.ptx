<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter13_coding_practice">
    <title>Chapter 13 Coding Practice</title>

    <exercise xml:id="chapter13_coding_shape_hierarchy">
        <title>Build a Two-Dimensional Shape Hierarchy</title>
        <statement>
            <p>
                Define an abstract <c>Shape2D</c> class with a pure virtual
                <c>calculate_area()</c> function and a virtual destructor. Implement
                <c>Circle</c>, <c>Rectangle</c>, <c>Ellipse</c>, and <c>Triangle</c>
                as derived classes.
            </p>
            <p>
                Create one object of each type and store pointers to them in a
                <c>std::array&lt;const Shape2D*, 4&gt;</c>. Use one loop to print each
                area. Do not allocate the objects dynamically.
            </p>
        </statement>
    </exercise>

    <exercise xml:id="chapter13_coding_interface_report">
        <title>Design a Printable and Savable Report</title>
        <statement>
            <p>
                Define two small abstract interfaces, <c>Printable</c> and
                <c>Savable</c>. Then define a concrete <c>Report</c> class that uses
                multiple inheritance to implement both interfaces.
            </p>
            <p>
                Write <c>print_document()</c> and <c>save_document()</c> functions
                that accept only the interface they need. Demonstrate calling both
                functions with one <c>Report</c> object.
            </p>
        </statement>
    </exercise>

    <exercise xml:id="chapter13_coding_safe_score">
        <title>Validate Scores with a Custom Exception</title>
        <statement>
            <p>
                Define an <c>InvalidScore</c> exception derived from
                <c>std::invalid_argument</c>. Its constructor should accept an
                integer score and pass a useful message to the base constructor.
            </p>
            <p>
                Write <c>validate_score()</c> to throw the exception when a score is
                outside the range 0 through 100. Catch the exception by constant
                reference and print its inherited <c>what()</c> message.
            </p>
        </statement>
    </exercise>

    <exercise xml:id="chapter13_coding_composition_alternative">
        <title>Replace Inheritance with Composition</title>
        <statement>
            <p>
                Design a <c>LabeledText</c> wrapper that contains a
                <c>std::string</c> and a label. Provide member functions to print the
                labeled text and report its length.
            </p>
            <p>
                Explain in a short comment why composition is preferable to publicly
                inheriting from <c>std::string</c> for this design.
            </p>
        </statement>
    </exercise>
</exercises>
