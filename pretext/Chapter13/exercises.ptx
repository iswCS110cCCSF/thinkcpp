<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter13_exercises">
    <title>Chapter 13 Exercises</title>

    <exercise xml:id="chapter13_exercise_relationship_choice">
        <statement>
            <p>Which relationship is represented when a <c>Car</c> contains an <c>Engine</c>?</p>
        </statement>
        <choices randomize="yes">
            <choice><statement><p>Is-a</p></statement><feedback><p>A car is not a specialized kind of engine.</p></feedback></choice>
            <choice correct="yes"><statement><p>Has-a</p></statement><feedback><p>The car has an engine component.</p></feedback></choice>
            <choice><statement><p>Overrides-a</p></statement><feedback><p>Overriding concerns inherited virtual functions.</p></feedback></choice>
            <choice><statement><p>Copies-a</p></statement><feedback><p>Copying is not the relationship described.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise xml:id="chapter13_exercise_access_control">
        <statement>
            <p>Which members can a derived class access directly?</p>
        </statement>
        <choices randomize="yes" multiple-correct="yes">
            <choice correct="yes"><statement><p>Public base members</p></statement><feedback><p>Public members are available through the inherited interface.</p></feedback></choice>
            <choice correct="yes"><statement><p>Protected base members</p></statement><feedback><p>Protected members are available to derived classes.</p></feedback></choice>
            <choice><statement><p>Every private base member</p></statement><feedback><p>Private base members are not directly accessible in derived classes.</p></feedback></choice>
            <choice><statement><p>Local variables in <c>main()</c></p></statement><feedback><p>Inheritance does not provide access to unrelated local variables.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise xml:id="chapter13_exercise_override_hiding">
        <statement>
            <p>Which statement correctly describes the difference between overriding and hiding?</p>
        </statement>
        <choices randomize="yes">
            <choice><statement><p>They are two names for exactly the same behavior.</p></statement><feedback><p>Overriding uses a matching virtual function; hiding is based on name lookup.</p></feedback></choice>
            <choice correct="yes"><statement><p>Overriding replaces a matching virtual function, while hiding can hide base overloads by name.</p></statement><feedback><p>This distinction explains the role of <c>override</c> and <c>using</c>.</p></feedback></choice>
            <choice><statement><p>Hiding always produces dynamic dispatch.</p></statement><feedback><p>Dynamic dispatch is associated with virtual functions.</p></feedback></choice>
            <choice><statement><p>Overriding can happen only for static functions.</p></statement><feedback><p>Static functions do not provide virtual dispatch.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise xml:id="chapter13_exercise_abstract_class">
        <statement>
            <p>Which statement about a pure virtual function is correct?</p>
        </statement>
        <choices randomize="yes">
            <choice><statement><p>It always returns zero.</p></statement><feedback><p><c>= 0</c> marks the declaration; it is not a return statement.</p></feedback></choice>
            <choice correct="yes"><statement><p>It requires a concrete derived class to provide an implementation.</p></statement><feedback><p>A pure virtual function defines a required operation.</p></feedback></choice>
            <choice><statement><p>It makes the function private.</p></statement><feedback><p>Access depends on the surrounding access specifier.</p></feedback></choice>
            <choice><statement><p>It prevents all derived classes from using the function.</p></statement><feedback><p>Derived classes are expected to implement the operation.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise xml:id="chapter13_exercise_polymorphic_collection">
        <statement>
            <p>Which statements correctly describe the <c>Shape2D</c> pointer array? Select all that apply.</p>
        </statement>
        <choices randomize="yes" multiple-correct="yes">
            <choice correct="yes"><statement><p>The array stores addresses of existing shape objects.</p></statement><feedback><p>The array element type is a pointer to <c>Shape2D</c>.</p></feedback></choice>
            <choice correct="yes"><statement><p>The same virtual call can calculate different shape areas.</p></statement><feedback><p>Dynamic dispatch selects each derived implementation.</p></feedback></choice>
            <choice><statement><p>The array stores four complete <c>Shape2D</c> objects by value.</p></statement><feedback><p><c>Shape2D</c> is abstract and the array stores pointers.</p></feedback></choice>
            <choice correct="yes"><statement><p>The local shape objects must remain alive while the pointers are used.</p></statement><feedback><p>The pointer array does not own those objects.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise xml:id="chapter13_exercise_multiple_interfaces">
        <statement>
            <p>Why might a class implement both <c>Printable</c> and <c>Savable</c>?</p>
        </statement>
        <choices randomize="yes">
            <choice><statement><p>To avoid writing any member functions.</p></statement><feedback><p>The concrete class must implement the interface operations.</p></feedback></choice>
            <choice correct="yes"><statement><p>To satisfy two independent public contracts.</p></statement><feedback><p>Each interface describes a different responsibility.</p></feedback></choice>
            <choice><statement><p>Because multiple inheritance is required for every class.</p></statement><feedback><p>Use it only when the design needs multiple interfaces.</p></feedback></choice>
            <choice><statement><p>To make all data members automatically public.</p></statement><feedback><p>Inheritance does not change data-member access in that way.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise xml:id="chapter13_exercise_custom_exception">
        <statement>
            <p>Which base class is most appropriate for an exception reporting an invalid function argument?</p>
        </statement>
        <choices randomize="yes">
            <choice><statement><p><c>std::runtime_error</c> in every situation</p></statement><feedback><p>Use the standard type that best describes the error.</p></feedback></choice>
            <choice correct="yes"><statement><p><c>std::invalid_argument</c></p></statement><feedback><p>An invalid argument is exactly the category represented by this standard type.</p></feedback></choice>
            <choice><statement><p><c>std::array</c></p></statement><feedback><p><c>std::array</c> is a container, not an exception type.</p></feedback></choice>
            <choice><statement><p><c>Shape2D</c></p></statement><feedback><p><c>Shape2D</c> is unrelated to exception classification.</p></feedback></choice>
        </choices>
    </exercise>
</exercises>
