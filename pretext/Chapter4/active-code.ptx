<?xml version="1.0" ?>
<exercises xml:id="chapter4_activecode-exercises">
  <title>Activecode Exercises</title>

  <introduction>
    <p>
      Complete or fix the following programs using the conditional concepts
      from this chapter.
    </p>
  </introduction>


  <!-- Remainder Operator and Conditional Execution -->

  <exercise label="cond_rec_a1">
    <statement>
      <p>
        Fix the code so that <q>THE TEAM</q> prints three times on separate
        lines.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a1q_editor">
        <code><![CDATA[
#include <iostream>

int main() {
    int x = 8;
    int y = 8;

    if (x % 2 == 0) {
        std::cout << "THE TEAM\n";
    }
    else if (x >= y) {
        std::cout << "THE TEAM\n";
    }
    else if (y >= x) {
        std::cout << "THE TEAM\n";
    }

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        All three conditions should be checked independently, so use three
        separate <c>if</c> statements.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a1_a_editor">
        <code><![CDATA[
#include <iostream>

int main() {
    int x = 8;
    int y = 8;

    if (x % 2 == 0) {
        std::cout << "THE TEAM\n";
    }

    if (x >= y) {
        std::cout << "THE TEAM\n";
    }

    if (y >= x) {
        std::cout << "THE TEAM\n";
    }

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- Logical Operators -->

  <exercise label="cond_rec_logical_a1">
    <statement>
      <p>
        Complete <c>report_temperature_comfort</c> so that it prints
        <q>Comfortable</q> when the temperature is from 60 through 80,
        inclusive, and <q>Uncomfortable</q> otherwise.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_logical_a1_editor">
        <code><![CDATA[
#include <iostream>

void report_temperature_comfort(int temperature) {
    // Write your code here.
}

int main() {
    report_temperature_comfort(72);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        The temperature must satisfy both the lower and upper limits.
        Combine two complete comparisons with a logical operator.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_logical_a1_solution">
        <code><![CDATA[
#include <iostream>

void report_temperature_comfort(int temperature) {
    if (temperature >= 60 && temperature <= 80) {
        std::cout << "Comfortable\n";
    }
    else {
        std::cout << "Uncomfortable\n";
    }
}

int main() {
    report_temperature_comfort(72);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <exercise label="cond_rec_a8">
    <statement>
      <p>
        Write the function <c>determine_exclusive_or</c>. It should return
        <c>true</c> when exactly one of its two Boolean arguments is true,
        and <c>false</c> otherwise. Use logical operators in the return
        expression.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a8_editor">
        <code><![CDATA[
#include <iostream>

bool determine_exclusive_or(bool a, bool b) {
    // Write your code here.
}

int main() {
    std::cout << determine_exclusive_or(true, false) << '\n';

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Exactly one value is true when at least one is true but they are
        not both true.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a8_solution">
        <code><![CDATA[
#include <iostream>

bool determine_exclusive_or(bool a, bool b) {
    return (a || b) && !(a && b);
}

int main() {
    std::cout << determine_exclusive_or(true, false) << '\n';

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- Alternative Execution -->

  <exercise label="cond_rec_a3">
    <statement>
      <p>
        Fix the function so that it prints <q>Odd</q> for odd integers and
        <q>Even</q> for even integers. It should work correctly for both
        positive and negative integers.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a3_editor">
        <code><![CDATA[
#include <iostream>

void report_parity(int number) {
    if (number % 2 == 0) {
        std::cout << "Even\n";
    }
}

int main() {
    report_parity(-3);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a3_solution">
        <code><![CDATA[
#include <iostream>

void report_parity(int number) {
    if (number % 2 == 0) {
        std::cout << "Even\n";
    }
    else {
        std::cout << "Odd\n";
    }
}

int main() {
    report_parity(-3);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- Chained Conditionals -->

  <exercise label="cond_rec_a2">
    <statement>
      <p>
        Fix the function so that it prints <q>C</q> for grades below 50,
        <q>B</q> for grades from 50 through 94, and <q>A</q> for grades
        95 or higher.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a2_editor">
        <code><![CDATA[
#include <iostream>

void report_letter_grade(double grade) {
    if (grade < 50.0) {
        std::cout << "C\n";
    }

    if (grade < 95.0) {
        std::cout << "B\n";
    }

    if (grade >= 95.0) {
        std::cout << "A\n";
    }
}

int main() {
    report_letter_grade(82.0);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Only one letter grade should print. Use one chained conditional so
        that the first matching branch ends the decision.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a2_solution">
        <code><![CDATA[
#include <iostream>

void report_letter_grade(double grade) {
    if (grade < 50.0) {
        std::cout << "C\n";
    }
    else if (grade < 95.0) {
        std::cout << "B\n";
    }
    else {
        std::cout << "A\n";
    }
}

int main() {
    report_letter_grade(82.0);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <exercise label="cond_rec_a5">
    <statement>
      <p>
        Write the function <c>report_temperature</c>. It should print
        <q>Cold</q> for temperatures below 50, <q>Mild</q> for
        temperatures from 50 through 74, and <q>Warm</q> for temperatures
        75 or higher.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a5_editor">
        <code><![CDATA[
#include <iostream>

void report_temperature(int temperature) {
    // Write your code here.
}

int main() {
    report_temperature(68);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Use one <c>if</c>/<c>else if</c>/<c>else</c> chain. Check the
        thresholds in an order that gives each temperature exactly one
        category.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a5_solution">
        <code><![CDATA[
#include <iostream>

void report_temperature(int temperature) {
    if (temperature < 50) {
        std::cout << "Cold\n";
    }
    else if (temperature < 75) {
        std::cout << "Mild\n";
    }
    else {
        std::cout << "Warm\n";
    }
}

int main() {
    report_temperature(68);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <exercise label="cond_rec_a6">
    <statement>
      <p>
        Write the function <c>report_comparison</c>. It should print
        <q>Greater</q> if the first <c>double</c> is greater than the
        second, <q>Less</q> if it is smaller, and <q>Equal</q> otherwise.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a6_editor">
        <code><![CDATA[
#include <iostream>

void report_comparison(double a, double b) {
    // Write your code here.
}

int main() {
    report_comparison(4.5, 7.2);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a6_solution">
        <code><![CDATA[
#include <iostream>

void report_comparison(double a, double b) {
    if (a > b) {
        std::cout << "Greater\n";
    }
    else if (a < b) {
        std::cout << "Less\n";
    }
    else {
        std::cout << "Equal\n";
    }
}

int main() {
    report_comparison(4.5, 7.2);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- Switch Statements -->

  <exercise label="cond_rec_switch_a1">
    <statement>
      <p>
        Complete <c>report_menu_choice</c> using a <c>switch</c>
        statement. Print <q>Add</q> for <c>'A'</c>, <q>Delete</q> for
        <c>'D'</c>, <q>Quit</q> for <c>'Q'</c>, and <q>Unknown</q>
        for any other choice.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_switch_a1_editor">
        <code><![CDATA[
#include <iostream>

void report_menu_choice(char choice) {
    // Write your switch statement here.
}

int main() {
    report_menu_choice('D');

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Use one <c>case</c> for each recognized character. End each of
        those branches with <c>break</c>, and use <c>default</c> for any
        other value.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_switch_a1_solution">
        <code><![CDATA[
#include <iostream>

void report_menu_choice(char choice) {
    switch (choice) {
        case 'A':
            std::cout << "Add\n";
            break;

        case 'D':
            std::cout << "Delete\n";
            break;

        case 'Q':
            std::cout << "Quit\n";
            break;

        default:
            std::cout << "Unknown\n";
    }
}

int main() {
    report_menu_choice('D');

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- Return in Conditional Branches -->

  <exercise label="cond_rec_a4">
    <statement>
      <p>
        Write the function <c>determine_larger</c>. It should return the
        larger of two integers. If they are equal, return either value.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a4_editor">
        <code><![CDATA[
#include <iostream>

int determine_larger(int a, int b) {
    // Write your code here.
}

int main() {
    std::cout << determine_larger(7, 12) << '\n';

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Compare the two parameters, then return the appropriate value from
        each branch.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a4_solution">
        <code><![CDATA[
#include <iostream>

int determine_larger(int a, int b) {
    if (a > b) {
        return a;
    }
    else {
        return b;
    }
}

int main() {
    std::cout << determine_larger(7, 12) << '\n';

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <exercise label="cond_rec_a7">
    <statement>
      <p>
        Complete the function so that it returns immediately when
        <c>temperature</c> is below -100. Otherwise, it should print the
        temperature.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a7q_editor">
        <code><![CDATA[
#include <iostream>

void report_valid_temperature(int temperature) {
    // Write your code here.
}

int main() {
    report_valid_temperature(72);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Use an <c>if</c> statement with an early <c>return</c> for the
        invalid case.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a7_solution">
        <code><![CDATA[
#include <iostream>

void report_valid_temperature(int temperature) {
    if (temperature < -100) {
        return;
    }

    std::cout << temperature << '\n';
}

int main() {
    report_valid_temperature(72);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- Optional Recursion -->

  <exercise label="cond_rec_a9">
    <statement>
      <p>
        <em>Optional recursion:</em> Write the function <c>count_down</c>.
        It should print each positive integer down to 1 and then print
        <q>Blastoff!</q>.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a9q_editor">
        <code><![CDATA[
#include <iostream>

void count_down(int number) {
    // Write your code here.
}

int main() {
    count_down(5);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Use zero as the base case. Otherwise, print the current value and
        make a recursive call with a smaller argument.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a9_solution">
        <code><![CDATA[
#include <iostream>

void count_down(int number) {
    if (number == 0) {
        std::cout << "Blastoff!\n";
    }
    else {
        std::cout << number << '\n';
        count_down(number - 1);
    }
}

int main() {
    count_down(5);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <exercise label="cond_rec_a10">
    <statement>
      <p>
        <em>Optional recursion:</em> Fix the recursive call so that this
        function eventually reaches its base case instead of recursing
        indefinitely.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a10_editor">
        <code><![CDATA[
#include <iostream>

void print_exclamation_marks(int count) {
    if (count > 0) {
        std::cout << "!";
        print_exclamation_marks(count + 1);
    }
}

int main() {
    print_exclamation_marks(4);

    return 0;
}
        ]]></code>
      </program>
    </statement>

    <hint>
      <p>
        Each recursive call should move the argument closer to the base
        case.
      </p>
    </hint>

    <solution>
      <program interactive="activecode"
               line-numbers="yes"
               label="cond_rec_a10_solution">
        <code><![CDATA[
#include <iostream>

void print_exclamation_marks(int count) {
    if (count > 0) {
        std::cout << "!";
        print_exclamation_marks(count - 1);
    }
}

int main() {
    print_exclamation_marks(4);

    return 0;
}
        ]]></code>
      </program>
    </solution>
  </exercise>

</exercises>
