<?xml version="1.0"?>
<exercises xml:id="chapter4_mixed-up-code-exercises">
  <title>Mixed-Up Code Exercises</title>

  <introduction>
    <p>
      Arrange the code blocks to construct solutions using the conditional
      concepts from this chapter.
    </p>
  </introduction>

  <exercise label="cond_recc_p1"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a program that prints the remainder when 18 is divided
        by 13.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>#include &lt;iostream&gt;</cline>
      </block>

      <block order="2">
        <cline>int main() {</cline>
      </block>

      <block order="3">
        <cline>    int dividend = 18;</cline>
        <cline>    int divisor = 13;</cline>
      </block>

      <block order="4">
        <choice correct="yes">
          <cline>    std::cout &lt;&lt; dividend % divisor &lt;&lt; '\n';</cline>
        </choice>
        <choice correct="no">
          <cline>    std::cout &lt;&lt; divisor % dividend &lt;&lt; '\n';</cline>
        </choice>
      </block>

      <block order="5">
        <cline>    return 0;</cline>
      </block>

      <block order="6">
        <cline>}</cline>
      </block>

      <block correct="no">
        <cline>    std::cout &lt;&lt; dividend / divisor &lt;&lt; '\n';</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p2"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function named <c>report_parity</c> that prints
        <q>Even</q> when an integer is even and <q>Odd</q> otherwise.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>void report_parity(int number) {</cline>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>    if (number % 2 == 0) {</cline>
        </choice>
        <choice correct="no">
          <cline>    if (number % 2 != 0) {</cline>
        </choice>
      </block>

      <block order="3">
        <cline><![CDATA[        std::cout << "Even\n";]]></cline>
      </block>

      <block order="4">
        <cline>    }</cline>
        <cline>    else {</cline>
      </block>

      <block order="5">
        <cline><![CDATA[        std::cout << "Odd\n";]]></cline>
      </block>

      <block order="6">
        <cline>    }</cline>
      </block>

      <block order="7">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p3"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that prints <c>a - b</c> when the difference
        is positive. Otherwise, it prints -1.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>void report_positive_difference(int a, int b) {</cline>
        </choice>
        <choice correct="no">
          <cline>int report_positive_difference(int a, int b) {</cline>
        </choice>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>    if (a - b &gt; 0) {</cline>
        </choice>
        <choice correct="no">
          <cline>    if (a - b &lt; 0) {</cline>
        </choice>
      </block>

      <block order="3">
        <cline>        std::cout &lt;&lt; a - b &lt;&lt; '\n';</cline>
      </block>

      <block order="4">
        <cline>    }</cline>
        <cline>    else {</cline>
      </block>

      <block order="5">
        <cline>        std::cout &lt;&lt; -1 &lt;&lt; '\n';</cline>
      </block>

      <block order="6">
        <cline>    }</cline>
      </block>

      <block order="7">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p4"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that checks all three conditions independently.
        Print <q>Odd</q> if <c>x</c> is odd, <q>Greater</q> if
        <c>x &gt; y</c>, and <q>Different</q> if <c>x != y</c>.
        More than one message may be printed.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>void report_number_relationships(int x, int y) {</cline>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>    if (x % 2 != 0) {</cline>
        </choice>
        <choice correct="no">
          <cline>    if (x % 2 == 0) {</cline>
        </choice>
      </block>

      <block order="3">
        <cline><![CDATA[        std::cout << "Odd\n";]]></cline>
        <cline>    }</cline>
      </block>

      <block order="4">
        <choice correct="yes">
          <cline>    if (x &gt; y) {</cline>
        </choice>
        <choice correct="no">
          <cline>    else if (x &gt; y) {</cline>
        </choice>
      </block>

      <block order="5">
        <cline><![CDATA[        std::cout << "Greater\n";]]></cline>
        <cline>    }</cline>
      </block>

      <block order="6">
        <choice correct="yes">
          <cline>    if (x != y) {</cline>
        </choice>
        <choice correct="no">
          <cline>    else if (x != y) {</cline>
        </choice>
      </block>

      <block order="7">
        <cline><![CDATA[        std::cout << "Different\n";]]></cline>
        <cline>    }</cline>
      </block>

      <block order="8">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p5"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct one chained conditional that prints <q>Equal</q> if
        <c>x == y</c>, <q>Less</q> if <c>x &lt; y</c>, and
        <q>Greater</q> otherwise.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>if (x == y) {</cline>
        </choice>
        <choice correct="no">
          <cline>if (x = y) {</cline>
        </choice>
      </block>

      <block order="2">
        <cline><![CDATA[    std::cout << "Equal\n";]]></cline>
      </block>

      <block order="3">
        <cline>}</cline>
        <cline>else if (x &lt; y) {</cline>
      </block>

      <block order="4">
        <cline><![CDATA[    std::cout << "Less\n";]]></cline>
      </block>

      <block order="5">
        <cline>}</cline>
        <cline>else {</cline>
      </block>

      <block order="6">
        <cline><![CDATA[    std::cout << "Greater\n";]]></cline>
      </block>

      <block order="7">
        <cline>}</cline>
      </block>

      <block correct="no">
        <cline>if (x &lt; y) {</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p6"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that prints a letter grade using these
        thresholds: 90 or above = A, 80 or above = B, 70 or above = C,
        and below 70 = F.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>void report_letter_grade(double grade) {</cline>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>    if (grade &gt;= 90.0) {</cline>
        </choice>
        <choice correct="no">
          <cline>    if (grade &gt;= 70.0) {</cline>
        </choice>
      </block>

      <block order="3">
        <cline><![CDATA[        std::cout << "A\n";]]></cline>
      </block>

      <block order="4">
        <cline>    }</cline>
        <cline>    else if (grade &gt;= 80.0) {</cline>
      </block>

      <block order="5">
        <cline><![CDATA[        std::cout << "B\n";]]></cline>
      </block>

      <block order="6">
        <cline>    }</cline>
        <cline>    else if (grade &gt;= 70.0) {</cline>
      </block>

      <block order="7">
        <cline><![CDATA[        std::cout << "C\n";]]></cline>
      </block>

      <block order="8">
        <cline>    }</cline>
        <cline>    else {</cline>
      </block>

      <block order="9">
        <cline><![CDATA[        std::cout << "F\n";]]></cline>
      </block>

      <block order="10">
        <cline>    }</cline>
      </block>

      <block order="11">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p7"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that returns the larger of two integers.
        If the values are equal, return either value.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>int determine_larger(int a, int b) {</cline>
        </choice>
        <choice correct="no">
          <cline>void determine_larger(int a, int b) {</cline>
        </choice>
      </block>

      <block order="2">
        <cline>    if (a &gt; b) {</cline>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline>        return a;</cline>
        </choice>
        <choice correct="no">
          <cline>        return b;</cline>
        </choice>
      </block>

      <block order="4">
        <cline>    }</cline>
        <cline>    else {</cline>
      </block>

      <block order="5">
        <choice correct="yes">
          <cline>        return b;</cline>
        </choice>
        <choice correct="no">
          <cline>        return a;</cline>
        </choice>
      </block>

      <block order="6">
        <cline>    }</cline>
      </block>

      <block order="7">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p8"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that uses nested conditionals to determine a
        seating area. A last initial after <c>'M'</c> selects the back;
        otherwise it selects the front. Within either area, a first initial
        after <c>'M'</c> selects the left; otherwise it selects the right.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>void determine_seating_area(char first_initial, char last_initial) {</cline>
      </block>

      <block order="2">
        <cline>    if (last_initial &gt; 'M') {</cline>
      </block>

      <block order="3">
        <cline>        if (first_initial &gt; 'M') {</cline>
        <cline><![CDATA[            std::cout << "Back Left\n";]]></cline>
        <cline>        }</cline>
      </block>

      <block order="4">
        <cline>        else {</cline>
        <cline><![CDATA[            std::cout << "Back Right\n";]]></cline>
        <cline>        }</cline>
      </block>

      <block order="5">
        <cline>    }</cline>
        <cline>    else {</cline>
      </block>

      <block order="6">
        <cline>        if (first_initial &gt; 'M') {</cline>
        <cline><![CDATA[            std::cout << "Front Left\n";]]></cline>
        <cline>        }</cline>
      </block>

      <block order="7">
        <cline>        else {</cline>
        <cline><![CDATA[            std::cout << "Front Right\n";]]></cline>
        <cline>        }</cline>
      </block>

      <block order="8">
        <cline>    }</cline>
      </block>

      <block order="9">
        <cline>}</cline>
      </block>

      <block correct="no">
        <cline>    else if (last_initial &gt; 'M') {</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p9"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        <em>Optional recursion:</em> Construct a recursive function that
        counts down from a positive integer and prints <q>Blastoff!</q>
        when it reaches zero.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>void count_down(int number) {</cline>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>    if (number == 0) {</cline>
        </choice>
        <choice correct="no">
          <cline>    if (number &gt; 0) {</cline>
        </choice>
      </block>

      <block order="3">
        <cline><![CDATA[        std::cout << "Blastoff!\n";]]></cline>
      </block>

      <block order="4">
        <cline>    }</cline>
        <cline>    else {</cline>
      </block>

      <block order="5">
        <cline>        std::cout &lt;&lt; number &lt;&lt; '\n';</cline>
      </block>

      <block order="6">
        <choice correct="yes">
          <cline>        count_down(number - 1);</cline>
        </choice>
        <choice correct="no">
          <cline>        count_down(number + 1);</cline>
        </choice>
      </block>

      <block order="7">
        <cline>    }</cline>
      </block>

      <block order="8">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <exercise label="cond_recc_p10"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        <em>Optional recursion:</em> Construct a recursive function that
        prints one exclamation mark for each positive value from
        <c>count</c> down to 1.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>void print_exclamation_marks(int count) {</cline>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>    if (count &gt; 0) {</cline>
        </choice>
        <choice correct="no">
          <cline>    if (count == 0) {</cline>
        </choice>
      </block>

      <block order="3">
        <cline><![CDATA[        std::cout << "!";]]></cline>
      </block>

      <block order="4">
        <choice correct="yes">
          <cline>        print_exclamation_marks(count - 1);</cline>
        </choice>
        <choice correct="no">
          <cline>        print_exclamation_marks(count + 1);</cline>
        </choice>
      </block>

      <block order="5">
        <cline>    }</cline>
      </block>

      <block order="6">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>

</exercises>
