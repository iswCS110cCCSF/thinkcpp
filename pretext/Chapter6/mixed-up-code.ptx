<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter6_mixed-up-code-exercises">
    <title>Mixed-Up Code Exercises</title>
    <introduction>
        <p>
            Arrange the blocks to create complete C++ programs. Pay attention to
            initialization, the loop condition, the loop body, and the update.
        </p>
    </introduction>

    <exercise label="chapter6_mixed_while_countdown"
              number="yes" adaptive="yes" indentation="show">
        <statement>
            <p>Arrange the blocks to print the numbers from 5 down to 1.</p>
        </statement>
        <blocks>
            <block order="1"><cline>#include &lt;iostream&gt;</cline></block>
            <block order="2"><cline>int main() {</cline></block>
            <block order="3"><cline>    int count = 5;</cline></block>
            <block order="4"><cline>    while (count &gt; 0) {</cline></block>
            <block order="5"><cline>        std::cout &lt;&lt; count &lt;&lt; '\n';</cline></block>
            <block order="6"><cline>        --count;</cline></block>
            <block order="7"><cline>    }</cline></block>
            <block order="8"><cline>    return 0;</cline></block>
            <block order="9"><cline>}</cline></block>
            <block order="10" correct="no"><cline>    ++count;</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter6_mixed_for_count"
              number="yes" adaptive="yes" indentation="show">
        <statement>
            <p>Arrange the blocks to print the numbers from 1 through 5 using a <c>for</c> loop.</p>
        </statement>
        <blocks>
            <block order="1"><cline>#include &lt;iostream&gt;</cline></block>
            <block order="2"><cline>int main() {</cline></block>
            <block order="3"><cline>    for (int number = 1; number &lt;= 5; ++number) {</cline></block>
            <block order="4"><cline>        std::cout &lt;&lt; number &lt;&lt; '\n';</cline></block>
            <block order="5"><cline>    }</cline></block>
            <block order="6"><cline>    return 0;</cline></block>
            <block order="7"><cline>}</cline></block>
            <block order="8" correct="no"><cline>    for (int number = 0; number &lt; 5; ++number) {</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter6_mixed_array_sum"
              number="yes" adaptive="yes" indentation="show">
        <statement>
            <p>Arrange the blocks to calculate and print the total of the array values.</p>
        </statement>
        <blocks>
            <block order="1"><cline>#include &lt;array&gt;</cline></block>
            <block order="2"><cline>#include &lt;iostream&gt;</cline></block>
            <block order="3"><cline>int main() {</cline></block>
            <block order="4"><cline>    const std::array&lt;int, 4&gt; values{3, 7, 2, 8};</cline></block>
            <block order="5"><cline>    int total = 0;</cline></block>
            <block order="6"><cline>    for (int value : values) {</cline></block>
            <block order="7"><cline>        total += value;</cline></block>
            <block order="8"><cline>    }</cline></block>
            <block order="9"><cline>    std::cout &lt;&lt; total &lt;&lt; '\n';</cline></block>
            <block order="10"><cline>    return 0;</cline></block>
            <block order="11"><cline>}</cline></block>
            <block order="12" correct="no"><cline>    total = value;</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter6_mixed_nested_pattern"
              number="yes" adaptive="yes" indentation="show">
        <statement>
            <p>Arrange the blocks to print a four-row increasing triangle of asterisks.</p>
        </statement>
        <blocks>
            <block order="1"><cline>#include &lt;iostream&gt;</cline></block>
            <block order="2"><cline>int main() {</cline></block>
            <block order="3"><cline>    for (int row = 1; row &lt;= 4; ++row) {</cline></block>
            <block order="4"><cline>        for (int symbol = 1; symbol &lt;= row; ++symbol) {</cline></block>
            <block order="5"><cline>            std::cout &lt;&lt; '*';</cline></block>
            <block order="6"><cline>        }</cline></block>
            <block order="7"><cline>        std::cout &lt;&lt; '\n';</cline></block>
            <block order="8"><cline>    }</cline></block>
            <block order="9"><cline>    return 0;</cline></block>
            <block order="10"><cline>}</cline></block>
            <block order="11" correct="no"><cline>    for (int symbol = 1; symbol &lt;= 4; ++symbol) {</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter6_mixed_object_array"
              number="yes" adaptive="yes" indentation="show">
        <statement>
            <p>Arrange the loop that reports the area of every rectangle.</p>
        </statement>
        <blocks>
            <block order="1"><cline>    for (const Rectangle&amp; rectangle : rectangles) {</cline></block>
            <block order="2"><cline>        std::cout &lt;&lt; rectangle.calculate_area() &lt;&lt; '\n';</cline></block>
            <block order="3"><cline>    }</cline></block>
            <block order="4" correct="no"><cline>    for (Rectangle rectangle : calculate_area) {</cline></block>
        </blocks>
    </exercise>
</exercises>
