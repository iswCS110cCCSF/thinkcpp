<?xml version="1.0" encoding="UTF-8"?>
<glossary xml:id="chapter9_glossary">
    <title>Glossary</title>

    <gi xml:id="glossary_ch9_address">
        <title>address</title>
        <p>The location of an object in a program's storage.</p>
    </gi>
    <gi xml:id="glossary_ch9_pointer">
        <title>pointer</title>
        <p>An object that stores the address of another object or function.</p>
    </gi>
    <gi xml:id="glossary_ch9_address-of">
        <title>address-of operator</title>
        <p>The <c>&amp;</c> operator used in an expression to obtain an object's address.</p>
    </gi>
    <gi xml:id="glossary_ch9_dereference">
        <title>dereference</title>
        <p>To use a pointer to access the object identified by its stored address.</p>
    </gi>
    <gi xml:id="glossary_ch9_lvalue">
        <title>lvalue</title>
        <p>An expression that identifies a persistent object or storage location.</p>
    </gi>
    <gi xml:id="glossary_ch9_rvalue">
        <title>rvalue</title>
        <p>An expression that generally represents a temporary value or computation result.</p>
    </gi>
    <gi xml:id="glossary_ch9_reference">
        <title>reference</title>
        <p>An alias that must bind to an object when it is initialized and is then used like that object.</p>
    </gi>
    <gi xml:id="glossary_ch9_null-pointer">
        <title>null pointer</title>
        <p>A pointer with the value <c>nullptr</c> that identifies no object.</p>
    </gi>
    <gi xml:id="glossary_ch9_dangling-pointer">
        <title>dangling pointer</title>
        <p>A pointer that still contains an address after the object at that address has been destroyed.</p>
    </gi>
    <gi xml:id="glossary_ch9_array-decay">
        <title>array-to-pointer conversion</title>
        <p>The conversion of an array expression, in many contexts, to a pointer to its first element. This is commonly called array decay.</p>
    </gi>
    <gi xml:id="glossary_ch9_pointer-arithmetic">
        <title>pointer arithmetic</title>
        <p>Adding, subtracting, or comparing pointers within the same array object to identify element positions.</p>
    </gi>
    <gi xml:id="glossary_ch9_one-past">
        <title>one-past-the-end pointer</title>
        <p>A pointer to the position immediately after the last element of an array; it may be used for comparison but not dereferenced.</p>
    </gi>
    <gi xml:id="glossary_ch9_c-string">
        <title>C-style string</title>
        <p>A sequence of characters in an array terminated by the null character <c>'\0'</c>.</p>
    </gi>
    <gi xml:id="glossary_ch9_null-character">
        <title>null character</title>
        <p>The character <c>'\0'</c> that marks the end of a C-style string.</p>
    </gi>
    <gi xml:id="glossary_ch9_command-line-argument">
        <title>command-line argument</title>
        <p>A text value supplied to a program when it is started.</p>
    </gi>
    <gi xml:id="glossary_ch9_dynamic-storage">
        <title>dynamic storage</title>
        <p>Storage requested during program execution whose lifetime is controlled by the program.</p>
    </gi>
    <gi xml:id="glossary_ch9_memory-leak">
        <title>memory leak</title>
        <p>Allocated storage that the program can no longer reach and therefore cannot release.</p>
    </gi>
    <gi xml:id="glossary_ch9_ownership">
        <title>ownership</title>
        <p>Responsibility for controlling an object's lifetime and releasing its dynamically managed storage.</p>
    </gi>
</glossary>
