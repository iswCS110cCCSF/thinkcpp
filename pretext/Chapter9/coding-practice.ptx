<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter9_coding-practice">
    <title>Coding Practice</title>

    <exercise label="chapter9_coding_increase_value">
        <statement>
            <p>
                Write <c>increase_value</c>, which takes an <c>int*</c> and
                increases the pointed-to integer by one when the pointer is not
                <c>nullptr</c>.
            </p>
            <program interactive="activecode" language="cpp" label="chapter9_coding_increase_value_editor">
                <code><![CDATA[
#include <iostream>

void increase_value(int* value_pointer) {
    // Write your solution here.
}

int main() {
    int value = 7;
    increase_value(&value);
    increase_value(nullptr);
    std::cout << value << '\n';
    return 0;
}
                ]]></code>
            </program>
        </statement>
        <solution>
            <program language="cpp"><code><![CDATA[
void increase_value(int* value_pointer) {
    if (value_pointer != nullptr) {
        ++(*value_pointer);
    }
}
            ]]></code></program>
        </solution>
    </exercise>

    <exercise label="chapter9_coding_print_array_pointer">
        <statement>
            <p>
                Write <c>print_values</c>, which takes a pointer to the first
                integer in an array and the array length. Use pointer arithmetic
                to print every element.
            </p>
            <program interactive="activecode" language="cpp" label="chapter9_coding_print_array_pointer_editor">
                <code><![CDATA[
#include <iostream>
#include <cstddef>

void print_values(const int* values, std::size_t count) {
    // Write your solution here.
}

int main() {
    const int values[]{4, 8, 12};
    print_values(values, 3);
    return 0;
}
                ]]></code>
            </program>
        </statement>
        <solution>
            <program language="cpp"><code><![CDATA[
void print_values(const int* values, std::size_t count) {
    const int* current = values;
    const int* end = values + count;

    while (current != end) {
        std::cout << *current << '\n';
        ++current;
    }
}
            ]]></code></program>
        </solution>
    </exercise>

    <exercise label="chapter9_coding_count_characters">
        <statement>
            <p>
                Write <c>count_character</c>, which takes a C-style string and
                a target character. Traverse the string with a pointer and
                return the number of matching characters.
            </p>
            <program interactive="activecode" language="cpp" label="chapter9_coding_count_characters_editor">
                <code><![CDATA[
#include <iostream>

int count_character(const char* text, char target) {
    // Write your solution here.
}

int main() {
    std::cout << count_character("banana", 'a') << '\n';
    return 0;
}
                ]]></code>
            </program>
        </statement>
        <solution>
            <program language="cpp"><code><![CDATA[
int count_character(const char* text, char target) {
    int count = 0;

    while (*text != '\0') {
        if (*text == target) {
            ++count;
        }
        ++text;
    }

    return count;
}
            ]]></code></program>
        </solution>
    </exercise>

    <exercise label="chapter9_coding_command_line_sum">
        <statement>
            <p>
                Complete <c>print_arguments</c> so that it prints each command-
                line argument and its index. Remember that the arguments are
                C-style strings.
            </p>
            <program interactive="activecode" language="cpp" label="chapter9_coding_command_line_sum_editor">
                <code><![CDATA[
#include <iostream>

void print_arguments(int argc, char* argv[]) {
    // Write your solution here.
}

int main(int argc, char* argv[]) {
    print_arguments(argc, argv);
    return 0;
}
                ]]></code>
            </program>
        </statement>
        <solution>
            <program language="cpp"><code><![CDATA[
void print_arguments(int argc, char* argv[]) {
    for (int index = 0; index < argc; ++index) {
        std::cout << index << ": " << argv[index] << '\n';
    }
}
            ]]></code></program>
        </solution>
    </exercise>

    <exercise label="chapter9_coding_dynamic_array_total">
        <statement>
            <p>
                Write a program that creates a dynamically allocated array of
                five integers, stores the values 2, 4, 6, 8, and 10, prints
                their total, and releases the array correctly.
            </p>
            <program interactive="activecode" language="cpp" label="chapter9_coding_dynamic_array_total_editor">
                <code><![CDATA[
#include <iostream>
#include <cstddef>

int main() {
    const std::size_t count = 5;
    // Create, use, and release the dynamic array.
    return 0;
}
                ]]></code>
            </program>
        </statement>
        <solution>
            <program language="cpp"><code><![CDATA[
    int* values = new int[count]{};
    int total = 0;

    for (std::size_t index = 0; index < count; ++index) {
        values[index] = static_cast<int>((index + 1) * 2);
        total += values[index];
    }

    std::cout << total << '\n';
    delete[] values;
            ]]></code></program>
        </solution>
    </exercise>
</exercises>
