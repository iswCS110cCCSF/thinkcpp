<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter9_exercises">
    <title>Exercises</title>

    <exercise label="chapter9_exercise_pointer_type">
        <statement><p>What does <c>int* pointer</c> declare?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>A pointer that can identify an <c>int</c> object</p></statement><feedback><p>The declaration's <c>*</c> makes <c>pointer</c> a pointer variable.</p></feedback></choice>
            <choice><statement><p>An integer whose value is an address</p></statement><feedback><p>The declared variable has pointer type, not ordinary integer type.</p></feedback></choice>
            <choice><statement><p>A pointer to any type of object</p></statement><feedback><p>The pointer type identifies the type it is designed to point to.</p></feedback></choice>
            <choice><statement><p>A function that returns an integer</p></statement><feedback><p>This declaration does not include a function parameter list.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_dereference">
        <statement><p>What does <c>*pointer</c> mean in an expression?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>Access the object identified by <c>pointer</c></p></statement><feedback><p>In an expression, <c>*</c> is the dereference operator.</p></feedback></choice>
            <choice><statement><p>Declare a new pointer</p></statement><feedback><p>Declaration syntax requires a type, such as <c>int*</c>.</p></feedback></choice>
            <choice><statement><p>Obtain the pointer's address</p></statement><feedback><p>The address-of operator <c>&amp;</c> obtains an address.</p></feedback></choice>
            <choice><statement><p>Delete the pointed-to object</p></statement><feedback><p>Deletion uses <c>delete</c>, not <c>*</c>.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_nullptr">
        <statement><p>What does <c>nullptr</c> represent?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>A pointer value that identifies no object</p></statement><feedback><p>It is the modern C++ null pointer value.</p></feedback></choice>
            <choice><statement><p>The first element of every array</p></statement><feedback><p>Array indexing begins at zero, but zero is not <c>nullptr</c>.</p></feedback></choice>
            <choice><statement><p>A dynamically allocated integer with value zero</p></statement><feedback><p><c>nullptr</c> is a pointer value, not an allocated integer.</p></feedback></choice>
            <choice><statement><p>A pointer that is always safe to dereference</p></statement><feedback><p>A null pointer must not be dereferenced.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_pointer_parameter">
        <statement><p>What can a non-constant pointer parameter allow a function to do?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>Modify the caller's object through a valid pointer</p></statement><feedback><p>Dereferencing a valid non-constant pointer accesses the caller's object.</p></feedback></choice>
            <choice><statement><p>Know the size of every object automatically</p></statement><feedback><p>A pointer does not generally store object-size information.</p></feedback></choice>
            <choice><statement><p>Guarantee that the pointer is never null</p></statement><feedback><p>The function may need to check for <c>nullptr</c>.</p></feedback></choice>
            <choice><statement><p>Change the pointer into a reference</p></statement><feedback><p>Pointer and reference types are distinct.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_array_decay">
        <statement><p>After an array decays when passed to a pointer parameter, what information is not carried by the pointer?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>The array's number of elements</p></statement><feedback><p>The pointer identifies an address, so the length must be supplied separately.</p></feedback></choice>
            <choice><statement><p>The address of the first element</p></statement><feedback><p>The converted pointer identifies the first element.</p></feedback></choice>
            <choice><statement><p>The element type used for pointer arithmetic</p></statement><feedback><p>The pointer type still determines its element step.</p></feedback></choice>
            <choice><statement><p>Whether the function can read the pointed-to values</p></statement><feedback><p>A valid pointer can be dereferenced to read values.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_pointer_arithmetic">
        <statement><p>What does <c>pointer + 1</c> mean when <c>pointer</c> points into an array?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>The address of the next element in that array</p></statement><feedback><p>Pointer arithmetic advances by the pointed-to element type.</p></feedback></choice>
            <choice><statement><p>The next byte in memory regardless of type</p></statement><feedback><p>Pointer arithmetic is scaled by the pointer's element type.</p></feedback></choice>
            <choice><statement><p>The value of the next element</p></statement><feedback><p>The result is still a pointer; dereference it to access a value.</p></feedback></choice>
            <choice><statement><p>A pointer to the next unrelated object</p></statement><feedback><p>Pointer arithmetic is defined within an array object.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_c_string">
        <statement><p>How many array elements are needed for the C-style string <c>"cat"</c>?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>4</p></statement><feedback><p>The array needs three visible characters plus <c>'\0'</c>.</p></feedback></choice>
            <choice><statement><p>3</p></statement><feedback><p>Three stores the visible characters but not the terminator.</p></feedback></choice>
            <choice><statement><p>2</p></statement><feedback><p>Count all three letters and the null character.</p></feedback></choice>
            <choice><statement><p>5</p></statement><feedback><p>No extra fifth element is required for this string.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_argv">
        <statement><p>What is the type of each individual <c>argv[index]</c> value?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>A pointer to a C-style character string</p></statement><feedback><p><c>argv</c> is an array of <c>char*</c> values.</p></feedback></choice>
            <choice><statement><p>An integer containing the argument count</p></statement><feedback><p><c>argc</c> contains the count; an individual <c>argv</c> entry is text.</p></feedback></choice>
            <choice><statement><p>A <c>std::string</c> object automatically</p></statement><feedback><p>The standard signature supplies C-style strings.</p></feedback></choice>
            <choice><statement><p>A pointer to a vector</p></statement><feedback><p><c>argv</c> is not a <c>std::vector</c>.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_new_delete">
        <statement><p>What must happen to storage created by <c>new int{7}</c>?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>It must eventually be released with matching <c>delete</c>.</p></statement><feedback><p>A single object created by <c>new</c> matches <c>delete</c>.</p></feedback></choice>
            <choice><statement><p>It must be released with <c>delete[]</c>.</p></statement><feedback><p><c>delete[]</c> matches <c>new[]</c>, not a single <c>new</c>.</p></feedback></choice>
            <choice><statement><p>It is automatically released at the end of the function.</p></statement><feedback><p>Dynamic storage is not automatically released like a local object.</p></feedback></choice>
            <choice><statement><p>It must be released with <c>std::vector::clear()</c>.</p></statement><feedback><p>The allocation is not a vector.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_dynamic_array">
        <statement><p>Why must a program keep the length separately after allocating <c>new int[count]</c>?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>The resulting pointer does not remember the number of elements.</p></statement><feedback><p>The length is separate information needed for safe traversal.</p></feedback></choice>
            <choice><statement><p>Because the array has no elements.</p></statement><feedback><p>The allocation creates <c>count</c> elements.</p></feedback></choice>
            <choice><statement><p>Because pointer arithmetic cannot access arrays.</p></statement><feedback><p>Pointer arithmetic can traverse the allocated array.</p></feedback></choice>
            <choice><statement><p>Because <c>delete[]</c> requires a length argument.</p></statement><feedback><p><c>delete[]</c> receives only the pointer.</p></feedback></choice>
        </choices>
    </exercise>

    <exercise label="chapter9_exercise_memory_error">
        <statement><p>What is a dangling pointer?</p></statement>
        <choices>
            <choice correct="yes"><statement><p>A pointer whose former object has already been destroyed</p></statement><feedback><p>The stored address remains, but the object lifetime has ended.</p></feedback></choice>
            <choice><statement><p>A pointer initialized to <c>nullptr</c></p></statement><feedback><p>A null pointer identifies no object but is not dangling.</p></feedback></choice>
            <choice><statement><p>A pointer to the first array element</p></statement><feedback><p>A valid pointer to an array element is not dangling.</p></feedback></choice>
            <choice><statement><p>A pointer that stores an array length</p></statement><feedback><p>Pointers store addresses, not lengths.</p></feedback></choice>
        </choices>
    </exercise>
</exercises>
