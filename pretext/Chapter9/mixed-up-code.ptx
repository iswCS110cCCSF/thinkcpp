<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="chapter9_mixed-up-code">
    <title>Mixed-Up Code Practice</title>

    <exercise label="chapter9_mixed_up_dereference" number="yes" adaptive="yes" indentation="hide">
        <statement><p>Arrange the blocks to modify <c>score</c> through a pointer.</p></statement>
        <blocks>
            <block order="1"><cline>int score = 90;</cline></block>
            <block order="2"><cline>int* score_pointer = &amp;score;</cline></block>
            <block order="3"><cline>*score_pointer = 95;</cline></block>
            <block order="4"><cline>std::cout &lt;&lt; score &lt;&lt; '\n';</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter9_mixed_up_null_check" number="yes" adaptive="yes" indentation="hide">
        <statement><p>Arrange the blocks to print a value only when the pointer identifies an object.</p></statement>
        <blocks>
            <block order="1"><cline>void print_value(const int* value_pointer) {</cline></block>
            <block order="2"><cline>    if (value_pointer != nullptr) {</cline></block>
            <block order="3"><cline>        std::cout &lt;&lt; *value_pointer &lt;&lt; '\n';</cline><cline>    }</cline></block>
            <block order="4"><cline>}</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter9_mixed_up_array_pointer" number="yes" adaptive="yes" indentation="hide">
        <statement><p>Arrange the blocks to traverse an array with a pointer.</p></statement>
        <blocks>
            <block order="1"><cline>int values[]{10, 20, 30};</cline></block>
            <block order="2"><cline>int* current = values;</cline></block>
            <block order="3"><cline>for (int index = 0; index &lt; 3; ++index) {</cline></block>
            <block order="4"><cline>    std::cout &lt;&lt; *current &lt;&lt; '\n';</cline><cline>    ++current;</cline><cline>}</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter9_mixed_up_c_string" number="yes" adaptive="yes" indentation="hide">
        <statement><p>Arrange the blocks to print a C-style string one character at a time.</p></statement>
        <blocks>
            <block order="1"><cline>char word[] = "cat";</cline></block>
            <block order="2"><cline>for (const char* current = word; *current != '\0'; ++current) {</cline></block>
            <block order="3"><cline>    std::cout &lt;&lt; *current &lt;&lt; '\n';</cline><cline>}</cline></block>
        </blocks>
    </exercise>

    <exercise label="chapter9_mixed_up_dynamic_value" number="yes" adaptive="yes" indentation="hide">
        <statement><p>Arrange the blocks to create and release one dynamic integer.</p></statement>
        <blocks>
            <block order="1"><cline>int* value_pointer = new int{42};</cline></block>
            <block order="2"><cline>std::cout &lt;&lt; *value_pointer &lt;&lt; '\n';</cline></block>
            <block order="3"><cline>delete value_pointer;</cline></block>
            <block order="4"><cline>value_pointer = nullptr;</cline></block>
        </blocks>
    </exercise>
</exercises>
