<?xml version="1.0" encoding="UTF-8"?>
<projects xml:id="chapter12_coding-practice">
    <title>Chapter 12 Coding Practice</title>

    <project xml:id="chapter12_project_score-analyzer">
        <title>CSV Score Analyzer</title>
        <statement>
            <p>
                Write a C++17 program that reads <c>scores.csv</c>. Each line
                contains a student name and score separated by a comma. Parse
                and validate every record, report malformed lines, and write a
                summary containing the number of valid records, the average, and
                the highest score to <c>score-report.txt</c>.
            </p>
        </statement>
    </project>

    <project xml:id="chapter12_project_inventory-report">
        <title>Inventory Report</title>
        <statement>
            <p>
                Process an inventory CSV file with fields for item ID, item name,
                quantity, and unit price. Validate nonnegative quantities and
                prices, calculate each item's inventory value, and write a
                formatted report to a separate text file.
            </p>
        </statement>
    </project>

    <project xml:id="chapter12_project_binary-records">
        <title>Binary Record Lookup</title>
        <statement>
            <p>
                Define a fixed-size binary score-record format. Write several
                records, then ask the user for a zero-based record number and use
                <c>seekg()</c> to read only that record. Document the assumptions
                about field widths and byte order.
            </p>
        </statement>
    </project>

    <project xml:id="chapter12_project_portable-format">
        <title>Portable Binary Format</title>
        <statement>
            <p>
                Design a small binary format with a magic value, version number,
                fixed-width fields, and an explicitly documented byte order.
                Write and read the format without copying an entire structure's
                raw memory. Reject files with an unexpected version or incomplete
                records.
            </p>
        </statement>
    </project>
</projects>
