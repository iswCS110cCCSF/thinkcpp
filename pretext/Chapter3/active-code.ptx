<?xml version="1.0"?>
<exercises xml:id="chapter3_activecode-exercises">
  <title>Activecode Exercises</title>

  <introduction>
    <p>
      Answer the following <term>Activecode</term> questions to assess what
      you have learned in this chapter.
    </p>
  </introduction>


  <!-- A1 -->
  <exercise label="functions_a1">
    <statement>
      <p>
        Fix the errors in the code below so that it prints the area of a
        circle. Use a <c>&lt;cmath&gt;</c> function to obtain an accurate
        value for pi.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a1q_editor">
        <code><![CDATA[
#include <iostream>
#include <cmath>

void print_area(double radius);

int main() {
    std::cout << "Testing with radius = 5...\n";
    std::cout << "    Your function had area = ";
    print_area(5.0);
    std::cout << '\n';

    std::cout << "Testing with radius = 7.5...\n";
    std::cout << "    Your function had area = ";
    print_area(7.5);
    std::cout << '\n';

    return 0;
}

void print_area(double radius) {
    double pi = std::acos(1.0);
    double area = pi * radius ^ 2;

    std::cout << area;
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        <c>std::acos(-1.0)</c> gives pi because cos(pi) = -1. C++ does not use <c>^</c> for
        exponentiation, so the radius can be squared by multiplying it by
        itself.
      </p>

      <program xml:id="functions_a1a_editor" line-numbers="yes">
        <code><![CDATA[
void print_area(double radius) {
    double pi = std::acos(-1.0); // cos(pi) = -1
    double area = pi * radius * radius;

    std::cout << area;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A2 -->
  <exercise label="functions_a2">
    <statement>
      <p>
        Fix the code below so that it prints <q>2 elephants</q>.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a2_editor">
        <code><![CDATA[
#include <iostream>
#include <string>

void print_animals(std::string animal, int count);

int main() {
    print_animals(2, "elephants");

    return 0;
}

void print_animals(std::string animal, int count) {
    std::cout << count << animal << '\n';
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        The arguments must match the corresponding parameter types and
        order, and a space is needed between the number and animal name.
      </p>

      <program xml:id="functions_a2a_editor" line-numbers="yes">
        <code><![CDATA[
#include <iostream>
#include <string>

void print_animals(int count, std::string animal);

int main() {
    print_animals(2, "elephants");

    return 0;
}

void print_animals(int count, std::string animal) {
    std::cout << count << " " << animal << '\n';
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A3 -->
  <exercise label="functions_a3">
    <statement>
      <p>
        Fix the code below so that it prints <c>12 / 8 = 1.5</c>.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a3q_editor">
        <code><![CDATA[
#include <iostream>

double divide(int first, int second);

int main() {
    int a = 8;
    int b = 12;

    std::cout << b << " / " << a << " = ";
    std::cout << divide(b, a) << '\n';

    return 0;
}

double divide(int first, int second) {
    return first / second;
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        Because both parameters are <c>int</c>, <c>first / second</c>
        performs integer division before the result is returned. One way to
        fix the function is to convert one operand to <c>double</c>.
      </p>

      <program xml:id="functions_a3a_editor" line-numbers="yes">
        <code><![CDATA[
double divide(int first, int second) {
    return static_cast<double>(first) / second;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A4 -->
  <exercise label="functions_a4">
    <statement>
      <p>
        Finish the function so that it returns the common logarithm of
        <c>a</c> minus the natural logarithm of <c>a</c>.
        You will need functions from <c>&lt;cmath&gt;</c>.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a4_editor">
        <code><![CDATA[
#include <iostream>
#include <cmath>

double log_difference(double a);

int main() {
    std::cout << log_difference(8.0) << '\n';

    return 0;
}

double log_difference(double a) {
    // Compute and return log base 10 of a minus natural log of a.
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        Use <c>std::log10</c> for the common logarithm and
        <c>std::log</c> for the natural logarithm.
      </p>

      <program xml:id="functions_a4a_editor" line-numbers="yes">
        <code><![CDATA[
double log_difference(double a) {
    return std::log10(a) - std::log(a);
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A5 -->
  <exercise label="functions_a5">
    <statement>
      <p>
        Finish the code so that it prints <q>First Line</q>, a border,
        and <q>Second Line</q> on three separate lines.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a5q_editor">
        <code><![CDATA[
#include <iostream>

void border();

int main() {
    // Write your code here.

    return 0;
}

void border() {
    std::cout << "------------\n";
}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        Print the first line, call <c>border</c>, and then print the
        second line.
      </p>

      <program xml:id="functions_a5a_editor" line-numbers="yes">
        <code><![CDATA[
#include <iostream>

void border();

int main() {
    std::cout << "First Line\n";
    border();
    std::cout << "Second Line\n";

    return 0;
}

void border() {
    std::cout << "------------\n";
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A6 -->
  <exercise label="functions_a6">
    <statement>
      <p>
        Write a function called <c>add_one</c> that takes an
        <c>int</c> by reference and increases the caller's variable by
        one.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a6_editor">
        <code><![CDATA[
#include <iostream>

void add_one();

int main() {
    int count = 5;

    add_one(count);

    std::cout << count << '\n';

    return 0;
}

void add_one() {

}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        Use a reference parameter so that changes made through the
        parameter affect the caller's variable.
      </p>

      <program xml:id="functions_a6a_editor" line-numbers="yes">
        <code><![CDATA[
#include <iostream>

void add_one(int& value);

int main() {
    int count = 5;

    add_one(count);

    std::cout << count << '\n';

    return 0;
}

void add_one(int& value) {
    value = value + 1;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A7 -->
  <exercise label="functions_a7">
    <statement>
      <p>
        Write a function called <c>round_up</c> that takes a
        <c>double</c> and returns the smallest integer value that is
        greater than or equal to it. Use a function from
        <c>&lt;cmath&gt;</c>.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a7q_editor">
        <code><![CDATA[
#include <iostream>
#include <cmath>

double round_up(double value);

int main() {
    std::cout << round_up(2.513) << '\n';
    std::cout << round_up(4.0) << '\n';

    return 0;
}

double round_up(double value) {

}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        <c>std::ceil</c> returns the smallest integer-valued
        floating-point value greater than or equal to its argument.
      </p>

      <program xml:id="functions_a7a_editor" line-numbers="yes">
        <code><![CDATA[
double round_up(double value) {
    return std::ceil(value);
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A8 -->
  <exercise label="functions_a8">
    <statement>
      <p>
        Write a value-returning function called <c>volume_prism</c> that
        takes three <c>double</c> side lengths and returns the volume of
        the rectangular prism.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a8_editor">
        <code><![CDATA[
#include <iostream>

double volume_prism();

int main() {
    std::cout << volume_prism(3.0, 4.0, 5.0) << '\n';
    std::cout << volume_prism(5.7, 3.9, 1.3) << '\n';

    return 0;
}

double volume_prism() {

}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        The function needs three <c>double</c> parameters and should
        return their product.
      </p>

      <program xml:id="functions_a8a_editor" line-numbers="yes">
        <code><![CDATA[
double volume_prism(double side1, double side2, double side3) {
    return side1 * side2 * side3;
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A9 -->
  <exercise label="functions_a9">
    <statement>
      <p>
        Write a function called <c>tan_degrees</c> that returns the
        tangent of an angle given in degrees. Use <c>3.14</c> for pi.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a9q_editor">
        <code><![CDATA[
#include <iostream>
#include <cmath>

double tan_degrees(double degrees);

int main() {
    std::cout << tan_degrees(45.0) << '\n';
    std::cout << tan_degrees(112.1) << '\n';

    return 0;
}

double tan_degrees(double degrees) {

}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        Convert the angle from degrees to radians before calling
        <c>std::tan</c>.
      </p>

      <program xml:id="functions_a9a_editor" line-numbers="yes">
        <code><![CDATA[
double tan_degrees(double degrees) {
    constexpr double pi = 3.14;
    double radians = degrees * pi / 180.0;

    return std::tan(radians);
}
        ]]></code>
      </program>
    </solution>
  </exercise>


  <!-- A10 -->
  <exercise label="functions_a10">
    <statement>
      <p>
        Write a value-returning function called <c>volume_sphere</c> that
        takes a <c>double</c> radius and returns the volume of the sphere.
        Use <c>3.14</c> for pi.
      </p>

      <program interactive="activecode"
               line-numbers="yes"
               label="functions_a10_editor">
        <code><![CDATA[
#include <iostream>

double volume_sphere(double radius);

int main() {
    std::cout << volume_sphere(3.0) << '\n';
    std::cout << volume_sphere(3.24) << '\n';

    return 0;
}

double volume_sphere(double radius) {

}
        ]]></code>
      </program>
    </statement>

    <solution>
      <p>
        Use <c>4.0 / 3.0</c> so the calculation uses floating-point
        division, and multiply the radius by itself three times.
      </p>

      <program xml:id="functions_a10a_editor" line-numbers="yes">
        <code><![CDATA[
double volume_sphere(double radius) {
    constexpr double pi = 3.14;

    return (4.0 / 3.0) * pi * radius * radius * radius;
}
        ]]></code>
      </program>
    </solution>
  </exercise>

</exercises>
