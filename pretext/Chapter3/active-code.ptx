      <code><![CDATA[
#include <iostream>

void int_division() {

}

int main() {
// DO NOT MODIFY ANYTHING BELOW THIS LINE
std::cout << "Testing with a = 2.4, b = 6.8...
"; std::cout << "    Your solution has a quotient of "; int_division(2.4, 6.8); std::cout << '\n'; std::cout << "    The correct solution has a quotient of 0
"; std::cout << "Testing with a = -8.6, b = 4.2...
"; std::cout << "    Your solution has a quotient of "; int_division(-8.6, 4.2); std::cout << '\n'; std::cout << "    The correct solution has a quotient of -2";
}
    ]]></code>
    </program>    </statement>

