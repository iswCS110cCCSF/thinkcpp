<?xml version="1.0"?>
<exercises xml:id="chapter3_mixed-up-code-exercises">
  <title>Mixed-Up Code Exercises</title>

  <introduction>
    <p>
      Answer the following <term>Mixed-Up Code</term> questions to assess
      what you have learned in this chapter.
    </p>
  </introduction>


  <!-- Explicit conversion -->
  <exercise label="functions_p9"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that takes a <c>double</c>, converts it to an
        <c>int</c>, and prints the converted value.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>void print_integer(double value) {</cline>
        </choice>
        <choice>
          <cline>void print_integer(int value) {</cline>
        </choice>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline> int converted = static_cast&lt;int&gt;(value);</cline>
        </choice>
        <choice>
          <cline> double converted = static_cast&lt;double&gt;(value);</cline>
        </choice>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline> std::cout &lt;&lt; converted &lt;&lt; '\n';</cline>
        </choice>
        <choice>
          <cline> std::cout converted;</cline>
        </choice>
      </block>

      <block order="4">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Calling one function from another -->
  <exercise label="functions_p0"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct two functions. <c>new_line</c> prints one blank line.
        <c>divider</c> calls <c>new_line</c>, prints a divider, and then
        calls <c>new_line</c> again.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>void new_line() {</cline>
      </block>

      <block order="2">
        <cline> std::cout &lt;&lt; '\n';</cline>
      </block>

      <block order="3">
        <cline>}</cline>
      </block>

      <block order="4">
        <choice correct="yes">
          <cline>void divider() {</cline>
        </choice>
        <choice>
          <cline>void divider(new_line) {</cline>
        </choice>
      </block>

      <block order="5">
        <choice correct="yes">
          <cline> new_line();</cline>
        </choice>
        <choice>
          <cline><![CDATA[ std::cout << new_line();]]></cline>
        </choice>
      </block>

      <block order="6">
        <cline><![CDATA[ std::cout << ". . . . . . . . . . . .\n";]]></cline>
      </block>

      <block order="7">
        <choice correct="yes">
          <cline> new_line();</cline>
        </choice>
        <choice>
          <cline> newline();</cline>
        </choice>
      </block>

      <block order="8">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Value-returning function -->
  <exercise label="functions_p1"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that returns the volume of a cone.
        Use <c>3.14</c> for pi.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>double cone_volume(double radius, double height) {</cline>
        </choice>
        <choice>
          <cline>void cone_volume(double radius, double height) {</cline>
        </choice>
      </block>

      <block order="2">
        <cline> constexpr double pi = 3.14;</cline>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline> double volume = (1.0 / 3.0) * pi * radius * radius * height;</cline>
        </choice>
        <choice>
          <cline> double volume = (1 / 3) * pi * radius * radius * height;</cline>
        </choice>
      </block>

      <block order="4">
        <choice correct="yes">
          <cline> return volume;</cline>
        </choice>
        <choice>
          <cline> std::cout &lt;&lt; volume;</cline>
        </choice>
      </block>

      <block order="5">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Standard library math function -->
  <exercise label="functions_p3"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that prints the sine of an angle given in
        degrees. Use <c>3.14</c> for pi.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>#include &lt;cmath&gt;</cline>
      </block>

      <block order="2">
        <cline>#include &lt;iostream&gt;</cline>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline>void print_sine_degrees(double degrees) {</cline>
        </choice>
        <choice>
          <cline>void print_sine_degrees() {</cline>
        </choice>
      </block>

      <block order="4">
        <cline> constexpr double pi = 3.14;</cline>
      </block>

      <block order="5">
        <choice correct="yes">
          <cline> double radians = degrees * pi / 180.0;</cline>
        </choice>
        <choice>
          <cline> double radians = degrees * 180.0 / pi;</cline>
        </choice>
      </block>

      <block order="6">
        <choice correct="yes">
          <cline> double sine = std::sin(radians);</cline>
        </choice>
        <choice>
          <cline> double sine = std::sin(degrees);</cline>
        </choice>
      </block>

      <block order="7">
        <cline> std::cout &lt;&lt; sine &lt;&lt; '\n';</cline>
      </block>

      <block order="8">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Returning a calculated result -->
  <exercise label="functions_p4"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that returns the final price of an item after
        a 30% discount and then 8% sales tax.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>double calculate_final_price(double item_price) {</cline>
        </choice>
        <choice>
          <cline>double calculate_final_price(std::string item_price) {</cline>
        </choice>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline> double discounted_price = item_price * 0.70;</cline>
        </choice>
        <choice>
          <cline> double discounted_price = item_price * 0.30;</cline>
        </choice>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline> double price_with_tax = discounted_price * 1.08;</cline>
        </choice>
        <choice>
          <cline> double price_with_tax = discounted_price * 0.08;</cline>
        </choice>
      </block>

      <block order="4">
        <cline> return price_with_tax;</cline>
      </block>

      <block order="5">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Composition of value-returning functions -->
  <exercise label="functions_p5"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Suppose <c>sum_of_squares</c> returns the sum of the squares of
        two numbers, and <c>root</c> returns the square root of one number.
        Construct a function that returns the hypotenuse of a right triangle.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>double hypotenuse(double side1, double side2) {</cline>
        </choice>
        <choice>
          <cline>void hypotenuse(double side1, double side2) {</cline>
        </choice>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline> double square_sum = sum_of_squares(side1, side2);</cline>
        </choice>
        <choice>
          <cline> double square_sum = root(side1, side2);</cline>
        </choice>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline> return root(square_sum);</cline>
        </choice>
        <choice>
          <cline> return sum_of_squares(square_sum);</cline>
        </choice>
      </block>

      <block order="4">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Pass by reference -->
  <exercise label="functions_p6"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that swaps the values of two <c>int</c>
        variables in the caller.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>void swap_values(int&amp; first, int&amp; second) {</cline>
        </choice>
        <choice>
          <cline>void swap_values(int first, int second) {</cline>
        </choice>
      </block>

      <block order="2">
        <cline> int temp = first;</cline>
      </block>

      <block order="3">
        <cline> first = second;</cline>
      </block>

      <block order="4">
        <choice correct="yes">
          <cline> second = temp;</cline>
        </choice>
        <choice>
          <cline> second = first;</cline>
        </choice>
      </block>

      <block order="5">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Multiple parameters and return value -->
  <exercise label="functions_p7"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Construct a function that takes a dollar amount and a cent amount
        and returns the total number of cents.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>int total_cents(int dollars, int cents) {</cline>
        </choice>
        <choice>
          <cline>int total_cents(int dollars, cents) {</cline>
        </choice>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline> int total = dollars * 100 + cents;</cline>
        </choice>
        <choice>
          <cline> int total = dollars + cents / 100;</cline>
        </choice>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline> return total;</cline>
        </choice>
        <choice>
          <cline> std::cout &lt;&lt; total;</cline>
        </choice>
      </block>

      <block order="4">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Function declaration, call, and returned result -->
  <exercise label="functions_p8"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Suppose the probability of snow is <c>0.14</c> and the probability
        of both snow and a snow day is <c>0.02</c>. Construct the program
        that calculates and prints the probability of a snow day given that
        it snows.
      </p>

      <p>
        Use the formula
        <c>P(A given B) = P(A and B) / P(B)</c>.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <cline>#include &lt;iostream&gt;</cline>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>double conditional_probability(double probability_b, double probability_both);</cline>
        </choice>
        <choice>
          <cline>double conditional_probability(double probability_b, probability_both);</cline>
        </choice>
      </block>

      <block order="3">
        <cline>int main() {</cline>
      </block>

      <block order="4">
        <cline> double p_snow = 0.14;</cline>
        <cline> double p_both = 0.02;</cline>
      </block>

      <block order="5">
        <choice correct="yes">
          <cline> double result = conditional_probability(p_snow, p_both);</cline>
        </choice>
        <choice>
          <cline> double result = conditional_probability(p_both, p_snow);</cline>
        </choice>
      </block>

      <block order="6">
        <cline> std::cout &lt;&lt; result &lt;&lt; '\n';</cline>
      </block>

      <block order="7">
        <cline> return 0;</cline>
      </block>

      <block order="8">
        <cline>}</cline>
      </block>

      <block order="9">
        <cline>double conditional_probability(double probability_b, double probability_both) {</cline>
      </block>

      <block order="10">
        <choice correct="yes">
          <cline> return probability_both / probability_b;</cline>
        </choice>
        <choice>
          <cline> return probability_b / probability_both;</cline>
        </choice>
      </block>

      <block order="11">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>


  <!-- Weighted final percentage -->
  <exercise label="functions_p2"
            number="yes"
            adaptive="yes"
            indentation="hide">
    <statement>
      <p>
        Two midterms are each worth 20% of a course grade, and the final
        exam is worth 60%. Construct a function that returns the weighted
        final percentage.
      </p>
    </statement>

    <blocks>
      <block order="1">
        <choice correct="yes">
          <cline>double final_percentage(double midterm1, double midterm2, double final_exam) {</cline>
        </choice>
        <choice>
          <cline>double final_percentage(double midterm1, midterm2, final_exam) {</cline>
        </choice>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline> double midterm_component = midterm1 * 0.20 + midterm2 * 0.20;</cline>
        </choice>
        <choice>
          <cline> int midterm_component = midterm1 * 0.20 + midterm2 * 0.20;</cline>
        </choice>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline> double final_component = final_exam * 0.60;</cline>
        </choice>
        <choice>
          <cline> double final_component = final_exam * 0.06;</cline>
        </choice>
      </block>

      <block order="4">
        <choice correct="yes">
          <cline> return midterm_component + final_component;</cline>
        </choice>
        <choice>
          <cline> return static_cast&lt;int&gt;(midterm_component + final_component);</cline>
        </choice>
      </block>

      <block order="5">
        <cline>}</cline>
      </block>
    </blocks>
  </exercise>

</exercises>
